<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Android 13+ runtime permission. Requested with a rationale right after sign-in. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
        Contacts import (FR-IMP-01). A runtime permission, asked for with a rationale BEFORE
        the system dialog and never at launch: the ask happens when the user has chosen to
        import, so the reason is on screen when the dialog appears.

        Read-only, and only what the review screen needs — name, phone, birthday, photo for
        display. Contacts the user does not select are never persisted, never synced, and
        never written to a log, an analytics event or a crash report.
    -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />

    <!--
        Re-arm alarms after a reboot. AlarmManager clears every alarm in the system on boot,
        so without this the first restart silently disables the whole local fallback.
    -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!--
        User-grantable, and deliberately NOT USE_EXACT_ALARM.

        USE_EXACT_ALARM is granted at install, but Play restricts it to apps whose core
        function is an alarm clock or a calendar. A birthday reminder is a plausible but not
        a certain fit, and betting the listing on it inside a milestone about reliability is
        not a bet to make quietly. Delivery degrades to setAndAllowWhileIdle when this is
        denied — minutes of drift rather than hours — and Settings offers the user the
        permission. See docs/M2_PLAN.md §5.
    -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />

    <application
        android:name=".WishKaroApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.WishKaro">

        <!--
            FR-VIEW-07 says the app must survive fold, unfold, rotation and resize without
            losing state, and calls that the part that actually breaks.

            Until M4 this activity declared:

                configChanges="orientation|screenSize|screenLayout|keyboardHidden
                               |smallestScreenSize|uiMode|density"

            Every one of those means "do not recreate me when this changes". So rotating or
            folding the phone destroyed nothing, no state was restored because none was ever
            lost, and FR-VIEW-07 would have come out TRUE FOR THE WRONG REASON — while a
            process death still lost everything, which is the case the requirement is
            actually about.

            They are gone, except keyboardHidden, which only saves a pointless recreation
            when the soft keyboard appears. Rotation, folding, resizing and multi-window all
            recreate the Activity now, and the state genuinely survives it (see
            MainActivity's bridges and the Navigation 3 back stack in
            in.wishkaro.app.ui.nav). docs/M4_PLAN.md §2.5.

            resizeableActivity is stated rather than left to default: FR-VIEW-09 names it,
            and an implicit default is not a decision anyone can read. There is no
            screenOrientation anywhere in this file, which is the other half of FR-VIEW-09.
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="keyboardHidden"
            android:resizeableActivity="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.WishKaro">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Tapping a reminder opens the app on that person. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="wishkaro" />
            </intent-filter>
        </activity>

        <service
            android:name=".push.WishKaroMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <!-- The local half of the reminder engine (FR-REM-02). Not exported: nothing
             outside this app has any business firing a reminder. -->
        <receiver
            android:name=".push.ReminderAlarmReceiver"
            android:exported="false" />

        <!-- Snooze 1h and Mark done (FR-REM-04). -->
        <receiver
            android:name=".push.ReminderActionReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="in.wishkaro.app.action.SNOOZE" />
                <action android:name="in.wishkaro.app.action.MARK_DONE" />
            </intent-filter>
        </receiver>

        <!-- Alarms do not survive a reboot or an app update; this re-arms them from the
             stored plan. Exported, because the system is the sender. -->
        <receiver
            android:name=".push.ReminderBootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!--
            FR-WID-01..03 and FR-VIEW-10. Exported because the launcher is the caller —
            that is what an app widget is — and it carries no data of its own: everything it
            draws comes from UpcomingRepository inside this process.

            APPWIDGET_UPDATE only: the provider is driven by Glance's updateAll on a data
            change and by a daily WorkManager job at local midnight (WidgetUpdates), not by
            updatePeriodMillis, which cannot be more frequent than 30 minutes and would wake
            the device for nothing on the 29 days a month when nothing changes.
        -->
        <receiver
            android:name=".widget.UpcomingWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_description">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/upcoming_widget_info" />
        </receiver>

        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="reminders_morning_of" />
    </application>
</manifest>
