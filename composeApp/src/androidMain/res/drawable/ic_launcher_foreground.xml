<?xml version="1.0" encoding="utf-8"?>
<!--
    A calendar page with one day marked.

    ## What it replaces, twice

    First `#FF6750A4` with a white gift box — Material's baseline purple, committed in M0 under
    *"Placeholder mark. A real icon is a launch task, not a walking-skeleton task."* Nine
    milestones later nothing had launched and it was still there.

    Then a diya, which M7 drew first and Dipen rejected: *"I want something so by just from icon
    you can recognise the app and its usage."* That is the right test and the lamp failed it. A
    flame says warmth, festivity, remembrance — it does not say **this app knows when the day
    is**, which is the entire product.

    ## Why this one

    A calendar is what the app IS, and the marked day is what the app DOES. It is also not an
    invention: `CalendarScreen` already draws exactly this — a grid of days with a dot on every
    one that holds something, and `DayCell` fills that dot in the accent. The icon is the app's
    own calendar view at 48dp, which is the strongest kind of icon there is: the home screen and
    the second tab agree about what the product looks like.

    The warm paper direction does the rest. Saffron header, ink dots, ivory page, one day in the
    accent — and the accent is the same `@color/wk_accent` every countdown in the app is drawn
    in, so the dot on the icon and the "in 9 days" on the list are literally the same colour.

    ## Geometry

    108x108 is the adaptive-icon standard. A launcher may mask anything outside the central
    72x72 and WILL mask outside a 66x66 circle, so everything here sits inside that circle:
    the page's rounded corners put their arc centres at 22.7 units from the middle, 9 of radius
    on top of that is 31.7, and the hanger tops are at 32.4 — both inside 33. Checked by
    arithmetic rather than by eye, because "it looked fine in the preview" is how a circular
    launcher crops the top off a calendar.

    Three colours, all from `values/colors.xml`, never literals. `ic_launcher_monochrome.xml` is
    the single-colour version Android 13+ themed icons need.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- The two hangers, behind the page so they tuck under its top edge. -->
    <path
        android:fillColor="@color/wk_ink"
        android:pathData="M42,25 A2.5,2.5 0 0 1 44.5,27.5 L44.5,33.5 A2.5,2.5 0 0 1 42,36 A2.5,2.5 0 0 1 39.5,33.5 L39.5,27.5 A2.5,2.5 0 0 1 42,25 Z" />
    <path
        android:fillColor="@color/wk_ink"
        android:pathData="M66,25 A2.5,2.5 0 0 1 68.5,27.5 L68.5,33.5 A2.5,2.5 0 0 1 66,36 A2.5,2.5 0 0 1 63.5,33.5 L63.5,27.5 A2.5,2.5 0 0 1 66,25 Z" />

    <!-- The frame: a filled ink rounded rect with the page drawn inside it, rather than a
         stroke. A stroke of width N centres itself on the path, so half of it lands outside
         the geometry the safe-zone arithmetic above was done on. -->
    <path
        android:fillColor="@color/wk_ink"
        android:pathData="M37,30 L71,30 A9,9 0 0 1 80,39 L80,69 A9,9 0 0 1 71,78 L37,78 A9,9 0 0 1 28,69 L28,39 A9,9 0 0 1 37,30 Z" />

    <!-- The page. -->
    <path
        android:fillColor="@color/wk_ground"
        android:pathData="M38,34 L70,34 A6,6 0 0 1 76,40 L76,68 A6,6 0 0 1 70,74 L38,74 A6,6 0 0 1 32,68 L32,40 A6,6 0 0 1 38,34 Z" />

    <!-- The header band: rounded at the top to follow the page, square at the bottom. -->
    <path
        android:fillColor="@color/wk_accent"
        android:pathData="M38,34 L70,34 A6,6 0 0 1 76,40 L76,47 L32,47 L32,40 A6,6 0 0 1 38,34 Z" />

    <!-- Seven ordinary days. -->
    <path android:fillColor="@color/wk_ink" android:pathData="M36,53 A3,3 0 1 1 36,59 A3,3 0 1 1 36,53 Z" />
    <path android:fillColor="@color/wk_ink" android:pathData="M48,53 A3,3 0 1 1 48,59 A3,3 0 1 1 48,53 Z" />
    <path android:fillColor="@color/wk_ink" android:pathData="M60,53 A3,3 0 1 1 60,59 A3,3 0 1 1 60,53 Z" />
    <path android:fillColor="@color/wk_ink" android:pathData="M72,53 A3,3 0 1 1 72,59 A3,3 0 1 1 72,53 Z" />
    <path android:fillColor="@color/wk_ink" android:pathData="M36,63 A3,3 0 1 1 36,69 A3,3 0 1 1 36,63 Z" />
    <path android:fillColor="@color/wk_ink" android:pathData="M48,63 A3,3 0 1 1 48,69 A3,3 0 1 1 48,63 Z" />
    <path android:fillColor="@color/wk_ink" android:pathData="M72,63 A3,3 0 1 1 72,69 A3,3 0 1 1 72,63 Z" />

    <!-- And the one that matters. -->
    <path android:fillColor="@color/wk_accent" android:pathData="M60,59.5 A6.5,6.5 0 1 1 60,72.5 A6.5,6.5 0 1 1 60,59.5 Z" />
</vector>
