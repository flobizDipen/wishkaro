<?xml version="1.0" encoding="utf-8"?>
<!--
    The splash icon: the same diya, on the splash window's own background.

    ## The geometry, which is the part that is easy to get wrong

    `windowSplashScreenAnimatedIcon` is drawn on a 288x288 canvas and the platform masks it to a
    circle of **192dp** — the outer third is clipped on every device. So the art cannot simply be
    the 108x108 launcher drawable scaled up: it would lose the flame's tip and the bowl's rim.

    The group below maps the launcher's 108x108 coordinate space onto that inner 192x192 square
    (scale 192/108 = 1.7778, offset (288-192)/2 = 48), so this file and `ic_launcher_foreground`
    draw the identical mark from the identical path data. The alternative — a second set of
    coordinates — is a second drawing that drifts.

    ## Colours

    `@color/wk_accent` and `@color/wk_ink`, which have `values-night` twins. So the splash is a
    saffron flame on ivory by day and a lighter flame on ink by night, matching the window it
    hands over to. The splash background is `@color/wk_ground` (see `themes.xml`), which is the
    same resource the window background uses — they cannot disagree.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="288dp"
    android:height="288dp"
    android:viewportWidth="288"
    android:viewportHeight="288">

    <group
        android:translateX="48"
        android:translateY="48"
        android:scaleX="1.7778"
        android:scaleY="1.7778">

        <path
            android:fillColor="@color/wk_accent"
            android:pathData="M54,29 C54,29 43,42 43,50.5 C43,57.2 47.9,62 54,62 C60.1,62 65,57.2 65,50.5 C65,42 54,29 54,29 Z" />

        <path
            android:fillColor="@color/wk_ink"
            android:pathData="M28,64 L80,64 C80,74 68.4,81 54,81 C39.6,81 28,74 28,64 Z" />
    </group>
</vector>
