<?xml version="1.0" encoding="utf-8"?>
<!--
    The same calendar as a single-colour silhouette, for Android 13+ themed icons.

    M7 item 6 asks for this layer by name, and it is the half of a launcher icon that is easiest
    to skip: without it, a phone with themed icons turned on draws WishKaro as the one normal
    icon in a home screen of tinted ones.

    The colour here is **not** the colour that appears on screen — the system tints a
    `<monochrome>` layer from the wallpaper palette and uses only the alpha. `@color/wk_ink` is
    used rather than a literal so this file still names no colour of its own.

    **It is not the foreground with the fills swapped.** A silhouette of the foreground is a
    solid ink slab, because the page, the header and the dots would all become the same colour.
    So the page is drawn as a RING — a frame with a hole in it, using `evenOdd` fill — the
    header becomes a bar inside that hole, and the marked day keeps its size while the ordinary
    days keep theirs. What survives the loss of colour is the thing that has to: a calendar with
    one day larger than the rest.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <path
        android:fillColor="@color/wk_ink"
        android:pathData="M42,25 A2.5,2.5 0 0 1 44.5,27.5 L44.5,33.5 A2.5,2.5 0 0 1 42,36 A2.5,2.5 0 0 1 39.5,33.5 L39.5,27.5 A2.5,2.5 0 0 1 42,25 Z" />
    <path
        android:fillColor="@color/wk_ink"
        android:pathData="M66,25 A2.5,2.5 0 0 1 68.5,27.5 L68.5,33.5 A2.5,2.5 0 0 1 66,36 A2.5,2.5 0 0 1 63.5,33.5 L63.5,27.5 A2.5,2.5 0 0 1 66,25 Z" />

    <!-- The frame as a ring: outer rounded rect, inner rounded rect, evenOdd to punch it out. -->
    <path
        android:fillColor="@color/wk_ink"
        android:fillType="evenOdd"
        android:pathData="M37,30 L71,30 A9,9 0 0 1 80,39 L80,69 A9,9 0 0 1 71,78 L37,78 A9,9 0 0 1 28,69 L28,39 A9,9 0 0 1 37,30 Z M38,34 L70,34 A6,6 0 0 1 76,40 L76,68 A6,6 0 0 1 70,74 L38,74 A6,6 0 0 1 32,68 L32,40 A6,6 0 0 1 38,34 Z" />

    <!-- The header, as a bar rather than a filled band so the page still reads as paper. -->
    <path android:fillColor="@color/wk_ink" android:pathData="M32,44 L76,44 L76,47 L32,47 Z" />

    <path android:fillColor="@color/wk_ink" android:pathData="M36,53 A3,3 0 1 1 36,59 A3,3 0 1 1 36,53 Z" />
    <path android:fillColor="@color/wk_ink" android:pathData="M48,53 A3,3 0 1 1 48,59 A3,3 0 1 1 48,53 Z" />
    <path android:fillColor="@color/wk_ink" android:pathData="M60,53 A3,3 0 1 1 60,59 A3,3 0 1 1 60,53 Z" />
    <path android:fillColor="@color/wk_ink" android:pathData="M72,53 A3,3 0 1 1 72,59 A3,3 0 1 1 72,53 Z" />
    <path android:fillColor="@color/wk_ink" android:pathData="M36,63 A3,3 0 1 1 36,69 A3,3 0 1 1 36,63 Z" />
    <path android:fillColor="@color/wk_ink" android:pathData="M48,63 A3,3 0 1 1 48,69 A3,3 0 1 1 48,63 Z" />
    <path android:fillColor="@color/wk_ink" android:pathData="M72,63 A3,3 0 1 1 72,69 A3,3 0 1 1 72,63 Z" />

    <path android:fillColor="@color/wk_ink" android:pathData="M60,59.5 A6.5,6.5 0 1 1 60,72.5 A6.5,6.5 0 1 1 60,59.5 Z" />
</vector>
