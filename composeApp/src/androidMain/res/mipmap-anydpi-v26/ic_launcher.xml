<?xml version="1.0" encoding="utf-8"?>
<!--
    minSdk is 26, so an adaptive icon is always available and no density fallbacks are needed.

    Three layers, and the third is the one M7 added. `<monochrome>` is what Android 13+ uses when
    the user turns on themed icons: without it the launcher falls back to drawing the normal
    icon, so WishKaro would sit on a themed home screen as the one app that had not been updated.
    It is a `v26` resource with a `v33` feature in it, which the platform simply ignores below
    33 — one file rather than two.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground android:drawable="@drawable/ic_launcher_foreground" />
    <monochrome android:drawable="@drawable/ic_launcher_monochrome" />
</adaptive-icon>
