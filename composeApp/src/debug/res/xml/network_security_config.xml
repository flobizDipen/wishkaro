<?xml version="1.0" encoding="utf-8"?>
<!--
  Debug builds only.

  M0 talks to a server on the developer's machine over plain HTTP, reached through
  `adb reverse tcp:3000 tcp:3000` (127.0.0.1) or the emulator's host alias (10.0.2.2).
  Cleartext is blocked by default from API 28, and it stays blocked in release:
  REQUIREMENTS.md §11 requires TLS everywhere, with certificate pinning on release builds.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">10.0.2.2</domain>
    </domain-config>
</network-security-config>
