-- Local mirror of the server's person table.
--
-- `pending_sync` is the outbox: a row written on the device is marked 1 and the sync engine
-- clears it once the server has acknowledged that write. Soft deletes are tombstones, never
-- DELETE, so a deletion made offline can still be pushed (D23).
-- COLUMN ORDER IS LOAD-BEARING. `ALTER TABLE ... ADD COLUMN` can only append, so a column
-- added by 1.sqm sits at the end of the physical table. `verifyMigrations` compares this
-- declaration against the result of replaying the migrations and fails the BUILD on any
-- difference, ordinal positions included. So M1's columns go after pending_sync, however
-- much they would prefer to sit beside the fields they relate to.
CREATE TABLE person (
    id                TEXT    NOT NULL PRIMARY KEY,
    display_name      TEXT    NOT NULL,
    relation_to_owner TEXT,
    is_self           INTEGER NOT NULL DEFAULT 0,
    updated_at        TEXT    NOT NULL,
    deleted_at        TEXT,
    pending_sync      INTEGER NOT NULL DEFAULT 0,
    -- ---- added in M1 (schema version 2) ----
    -- Profile fields (FR-PPL-04). photo_key is reserved; uploads are M6.
    photo_key         TEXT,
    gender            TEXT,
    phone             TEXT,
    email             TEXT,
    notes             TEXT,
    -- Derived SERVER-SIDE and mirrored here for offline reads. The client never computes
    -- these and never pushes them; they arrive on a sync pull like any other column.
    is_deceased       INTEGER NOT NULL DEFAULT 0,
    is_minor          INTEGER NOT NULL DEFAULT 0,
    completeness_score INTEGER NOT NULL DEFAULT 0,
    -- ---- added in M1 (schema version 3) ----
    -- The server's ordered "what to add next" list, comma-separated. Mirrored rather than
    -- recomputed so COMPLETENESS_WEIGHTS stays the only place the ordering is decided.
    completeness_suggestions TEXT NOT NULL DEFAULT '',
    -- ---- added in M3 (schema version 6) ----
    -- Set when the server rejected THIS row by name, with the server's own reason. The row
    -- keeps pending_sync = 1 — it still holds an unsent change — but leaves the drain, so
    -- one row the server will never accept cannot stop every other row from reaching it.
    -- See 5.sqm, and docs/M3_PLAN.md §1.6.
    sync_blocked      INTEGER NOT NULL DEFAULT 0,
    sync_block_reason TEXT
);

CREATE INDEX person_pending_sync ON person(pending_sync);

selectAll:
SELECT * FROM person WHERE deleted_at IS NULL ORDER BY display_name;

selectById:
SELECT * FROM person WHERE id = ?;

-- The outbox, as the sync engine drains it.
--
-- Three things this query says that the one it replaced did not:
--
--   `sync_blocked = 0` — a row the server has named and refused is set aside rather than
--   re-sent on every run for ever.
--
--   `ORDER BY updated_at, id` — oldest first, and deterministic. With a LIMIT, an unordered
--   query would hand back an arbitrary slice each run, so a large outbox could re-read the
--   same rows and never reach the rest.
--
--   `LIMIT` — M3 can produce an outbox of thousands in one go. Unbounded, a single push
--   tried to carry all of them, which is the failure docs/M3_PLAN.md §1 is about. The engine
--   pages this snapshot; what does not fit goes on the next run.
selectPendingSync:
SELECT * FROM person
WHERE pending_sync = 1 AND sync_blocked = 0
ORDER BY updated_at, id
LIMIT :limit;

-- Still pending, but set aside: the server named this row and refused it.
selectBlocked:
SELECT * FROM person WHERE sync_blocked = 1 ORDER BY updated_at;

countBlocked:
SELECT COUNT(*) FROM person WHERE sync_blocked = 1;

markSyncBlocked:
UPDATE person SET sync_blocked = 1, sync_block_reason = ? WHERE id = ?;

clearSyncBlocked:
UPDATE person SET sync_blocked = 0, sync_block_reason = NULL WHERE id = ?;

-- NOTE: no `ON CONFLICT ... DO UPDATE` (UPSERT) anywhere in this schema.
-- UPSERT needs SQLite 3.24, which arrived in Android 11 (API 30). minSdk is 26 (OD-13), so
-- on an Android 8 device that syntax is a runtime parse error. INSERT OR REPLACE is
-- equivalent here because every column is always supplied, and the conditional
-- last-write-wins that `applyRemote` used to express lives in LocalStore.kt instead, where
-- it is easier to read anyway.

insertOrReplace:
INSERT OR REPLACE INTO person(
    id, display_name, relation_to_owner, is_self,
    photo_key, gender, phone, email, notes,
    is_deceased, is_minor, completeness_score, completeness_suggestions,
    updated_at, deleted_at, pending_sync
) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

-- Search and filter (FR-PPL-10). Done in SQL rather than in Kotlin so it still works with
-- the radio off and stays O(index) at 1,000 people.
search:
SELECT * FROM person
WHERE deleted_at IS NULL
  AND (:query IS NULL OR display_name LIKE '%' || :query || '%' COLLATE NOCASE)
  AND (:relation IS NULL OR relation_to_owner = :relation COLLATE NOCASE)
ORDER BY display_name;

selectDeleted:
SELECT * FROM person WHERE deleted_at IS NOT NULL ORDER BY deleted_at DESC;

-- A local edit: bumps updated_at and re-queues the row for sync.
updateProfile:
UPDATE person SET
    display_name = ?, relation_to_owner = ?, gender = ?, phone = ?, email = ?, notes = ?,
    is_deceased = ?, updated_at = ?, pending_sync = 1,
    -- A user edit clears the block. Whatever the server refused, this is different data
    -- now, and leaving the row set aside would make the edit silently unsendable.
    sync_blocked = 0, sync_block_reason = NULL
WHERE id = ?;

-- Soft delete, as a tombstone the sync engine will push (D23).
markDeleted:
UPDATE person SET deleted_at = ?, updated_at = ?, pending_sync = 1,
    sync_blocked = 0, sync_block_reason = NULL WHERE id = ?;

markRestored:
UPDATE person SET deleted_at = NULL, updated_at = ?, pending_sync = 1,
    sync_blocked = 0, sync_block_reason = NULL WHERE id = ?;

-- Take ONLY the columns the server owns, leaving everything else as it is.
--
-- Used when last-write-wins says the local copy of a row is the newer one. That ruling is
-- right for the fields the USER writes and meaningless for these three, which the client
-- never writes and therefore can never hold a newer version of. Arbitrating them with a
-- client clock is a category error, and it cost M3 every completeness score on a handset
-- whose clock ran two seconds fast — see docs/M3_VERIFY.md §6.3.
--
-- `is_deceased` is deliberately NOT here. FR-PPL-04 makes it a profile field the user can
-- set, so it is not purely derived and the ordinary last-write-wins is correct for it.
applyServerDerived:
UPDATE person SET is_minor = ?, completeness_score = ?, completeness_suggestions = ?
WHERE id = ?;

clearPendingSync:
UPDATE person SET pending_sync = 0 WHERE id = ?;

-- Re-assert a local edit the server rejected as STALE.
--
-- The server's copy carried a newer `updated_at` — which it can do without anybody editing
-- anything, because the server bumps that column when it re-derives completeness or is_minor.
-- Clearing the outbox there would throw away a real offline edit, so the row keeps its
-- pending flag and is re-stamped just past the server's clock, which the next push wins.
restampPending:
UPDATE person SET updated_at = ?, pending_sync = 1 WHERE id = ?;

deleteAll:
DELETE FROM person;
