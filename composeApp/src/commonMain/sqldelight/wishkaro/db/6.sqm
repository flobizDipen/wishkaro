-- Schema version 6 -> 7 (M5: wish history).
--
-- One new table and three indexes. No ALTER, no back-fill, nothing an existing install can
-- lose: an app upgrading from M4 gains an empty `wish` table and its next sync pull fills it,
-- because the server's cursor has no `wish` key in that client's saved cursor and therefore
-- sends every wish it has never seen (sync-cursor.ts).
--
-- WHY THIS EXISTS. FR-WSH-02 conditions every draft on "what was sent in previous years (must
-- not repeat)", FR-WSH-07 records a wish after the hand-off, FR-PPL-07 shows the history on
-- the person screen and FR-HIS-05 hangs the enrichment nudge off it. Four requirements that
-- all read one table, and it did not exist. See docs/M5_PLAN.md §2 and
-- docs/BUILD_PROMPT_M5.md, "Why history goes first".
--
-- The column list below must match Wish.sq EXACTLY, ordinals included. `verifyMigrations`
-- replays these migrations and compares the result against the .sq declarations, failing the
-- BUILD on any difference — which is what makes it safe to have the schema written twice.
CREATE TABLE wish (
    id                TEXT    NOT NULL PRIMARY KEY,
    person_id         TEXT    NOT NULL,
    type              TEXT    NOT NULL,
    occurrence_year   INTEGER NOT NULL,
    sentiment         TEXT    NOT NULL DEFAULT 'SOLEMN',
    event_id          TEXT,
    message_text      TEXT    NOT NULL,
    tone              TEXT    NOT NULL,
    language          TEXT    NOT NULL,
    channel           TEXT    NOT NULL,
    source            TEXT    NOT NULL,
    poster_id         TEXT,
    sent_at           TEXT    NOT NULL,
    updated_at        TEXT    NOT NULL,
    deleted_at        TEXT,
    pending_sync      INTEGER NOT NULL DEFAULT 0,
    sync_blocked      INTEGER NOT NULL DEFAULT 0,
    sync_block_reason TEXT
);

CREATE INDEX wish_person ON wish(person_id);
CREATE INDEX wish_pending_sync ON wish(pending_sync);
CREATE INDEX wish_occasion ON wish(person_id, type, occurrence_year);
