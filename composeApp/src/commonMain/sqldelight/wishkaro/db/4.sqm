-- Schema version 4 -> 5 (M2: settings and the local reminder plan).
--
-- Two new tables and no altered ones, so there is nothing to back-fill and nothing an
-- existing install can lose. `verifyMigrations` is on, so this file is what stops an
-- installed app crashing on its first query after the update.
CREATE TABLE user_settings (
    id                 INTEGER NOT NULL PRIMARY KEY,
    reminder_hour      INTEGER NOT NULL DEFAULT 9,
    ladder_d7          INTEGER NOT NULL DEFAULT 1,
    ladder_d1          INTEGER NOT NULL DEFAULT 1,
    ladder_d0          INTEGER NOT NULL DEFAULT 1,
    quiet_hours_start  INTEGER,
    quiet_hours_end    INTEGER,
    digest_enabled     INTEGER NOT NULL DEFAULT 0,
    digest_hour        INTEGER NOT NULL DEFAULT 9,
    timezone           TEXT NOT NULL DEFAULT 'Asia/Kolkata',
    updated_at         TEXT NOT NULL DEFAULT '1970-01-01T00:00:00Z',
    pending_sync       INTEGER NOT NULL DEFAULT 0
);

INSERT OR IGNORE INTO user_settings(id) VALUES (0);

CREATE TABLE scheduled_reminder (
    dedupe_key    TEXT NOT NULL PRIMARY KEY,
    scheduled_at  TEXT NOT NULL,
    offset_rung   TEXT NOT NULL,
    title         TEXT NOT NULL,
    body          TEXT NOT NULL,
    person_id     TEXT,
    person_name   TEXT,
    event_type    TEXT,
    sentiment     TEXT,
    deep_link     TEXT,
    source        TEXT NOT NULL DEFAULT 'PLAN',
    fired_at      TEXT
);

CREATE INDEX scheduled_reminder_at ON scheduled_reminder(scheduled_at);
