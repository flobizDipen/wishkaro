-- Column order is load-bearing; see the note in Person.sq.
CREATE TABLE event (
    id           TEXT    NOT NULL PRIMARY KEY,
    person_id    TEXT    NOT NULL,
    type         TEXT    NOT NULL DEFAULT 'BIRTHDAY',
    day          INTEGER NOT NULL,
    month        INTEGER NOT NULL,
    -- Nullable on purpose: "year unknown" is a first-class birthday (FR-EVT-02).
    year         INTEGER,
    updated_at   TEXT    NOT NULL,
    deleted_at   TEXT,
    pending_sync INTEGER NOT NULL DEFAULT 0,
    -- ---- added in M1 (schema version 2) ----
    -- Mirrored from the server, NEVER computed here. The client must be able to pick its
    -- tone offline, and a UI that guessed sentiment from `type` would get a remembrance
    -- birthday wrong in exactly the way FR-EVT-05 forbids.
    sentiment    TEXT    NOT NULL DEFAULT 'CELEBRATORY',
    -- User-supplied name for a CUSTOM event (FR-EVT-06); null for every other type.
    label        TEXT,
    -- Stops reminders without deleting the event. A deceased person's birthday arrives
    -- muted; un-muting it is the remembrance opt-in (FR-EVT-05).
    is_muted     INTEGER NOT NULL DEFAULT 0,
    -- ---- added in M3 (schema version 6) ----
    -- See Person.sq and 5.sqm: a row the server named and refused leaves the drain without
    -- losing its pending flag, so it cannot jam the rows around it.
    sync_blocked INTEGER NOT NULL DEFAULT 0,
    sync_block_reason TEXT
);

CREATE INDEX event_person ON event(person_id);
CREATE INDEX event_pending_sync ON event(pending_sync);

selectAll:
SELECT * FROM event WHERE deleted_at IS NULL;

selectById:
SELECT * FROM event WHERE id = ?;

selectForPerson:
SELECT * FROM event WHERE person_id = ? AND deleted_at IS NULL;

-- Including tombstones. Restoring a person has to find the rows its own delete hid.
selectAllForPerson:
SELECT * FROM event WHERE person_id = ?;

selectPendingSync:
SELECT * FROM event
WHERE pending_sync = 1 AND sync_blocked = 0
ORDER BY updated_at, id
LIMIT :limit;

selectBlocked:
SELECT * FROM event WHERE sync_blocked = 1 ORDER BY updated_at;

countBlocked:
SELECT COUNT(*) FROM event WHERE sync_blocked = 1;

markSyncBlocked:
UPDATE event SET sync_blocked = 1, sync_block_reason = ? WHERE id = ?;

clearSyncBlocked:
UPDATE event SET sync_blocked = 0, sync_block_reason = NULL WHERE id = ?;

-- NOTE: no `ON CONFLICT ... DO UPDATE` (UPSERT) anywhere in this schema.
-- UPSERT needs SQLite 3.24, which arrived in Android 11 (API 30). minSdk is 26 (OD-13), so
-- on an Android 8 device that syntax is a runtime parse error. INSERT OR REPLACE is
-- equivalent here because every column is always supplied, and the conditional
-- last-write-wins that `applyRemote` used to express lives in LocalStore.kt instead, where
-- it is easier to read anyway.

insertOrReplace:
INSERT OR REPLACE INTO event(
    id, person_id, type, sentiment, label, is_muted,
    day, month, year, updated_at, deleted_at, pending_sync
) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

updateEvent:
UPDATE event SET type = ?, label = ?, day = ?, month = ?, year = ?, updated_at = ?, pending_sync = 1,
    -- A user edit clears any block: this is different data from whatever the server
    -- refused, and leaving it set aside would make the edit silently unsendable.
    sync_blocked = 0, sync_block_reason = NULL
WHERE id = ?;

setMuted:
UPDATE event SET is_muted = ?, updated_at = ?, pending_sync = 1,
    sync_blocked = 0, sync_block_reason = NULL WHERE id = ?;

markDeleted:
UPDATE event SET deleted_at = ?, updated_at = ?, pending_sync = 1,
    sync_blocked = 0, sync_block_reason = NULL WHERE id = ?;

markRestored:
UPDATE event SET deleted_at = NULL, updated_at = ?, pending_sync = 1,
    sync_blocked = 0, sync_block_reason = NULL WHERE id = ?;

selectByMonth:
SELECT * FROM event WHERE month = ? AND deleted_at IS NULL;

clearPendingSync:
UPDATE event SET pending_sync = 0 WHERE id = ?;

-- See person.restampPending: re-assert a local edit the server rejected as STALE.
restampPending:
UPDATE event SET updated_at = ?, pending_sync = 1 WHERE id = ?;

deleteAll:
DELETE FROM event;

-- Events this device has created or edited and the server has never acknowledged.
--
-- The local-alarm fallback (FR-REM-10) arms only for these: the moment an event reaches the
-- server the plan governs it, and a fallback firing at the global hour would otherwise claim
-- the dedupe key and suppress the server's correctly-scheduled reminder.
--
-- Deliberately NOT filtered by `sync_blocked`, unlike selectPendingSync. A blocked event is
-- one the server will never accept, so it will never get a plan row — which makes the local
-- fallback the only reminder it is ever going to have. Dropping it here would silence the
-- user's event because of a wire-format problem they cannot see.
selectUnsynced:
SELECT * FROM event WHERE pending_sync = 1 AND deleted_at IS NULL AND is_muted = 0;
