-- Exactly one row, id = 0. Holds the opaque sync cursor the server handed back.
CREATE TABLE sync_state (
    id     INTEGER NOT NULL PRIMARY KEY,
    cursor TEXT
);

INSERT OR IGNORE INTO sync_state(id, cursor) VALUES (0, NULL);

selectCursor:
SELECT cursor FROM sync_state WHERE id = 0;

setCursor:
UPDATE sync_state SET cursor = ? WHERE id = 0;

reset:
UPDATE sync_state SET cursor = NULL WHERE id = 0;
