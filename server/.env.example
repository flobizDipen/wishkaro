# WishKaro server — copy to `.env` and fill in.
# `.env` is gitignored. This repo is PUBLIC: never commit real values.

NODE_ENV=development
PORT=3000

# ---- Datastores (match infra/docker-compose.yml) ----
DATABASE_URL=postgresql://wishkaro:wishkaro@localhost:5432/wishkaro
REDIS_URL=redis://localhost:6379

# ---- Auth ----
# The *Web* OAuth client ID from Google Cloud Console — NOT the Android one.
# The Android app requests the token; this server validates its audience against this value.
GOOGLE_CLIENT_ID=

# Generate each with: openssl rand -base64 48
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=60d

# ---- Firebase Admin (FCM) ----
# From Firebase Console → Project settings → Service accounts → Generate new private key.
# Keep the JSON file OUTSIDE this repo and point at it with an absolute path.
FIREBASE_PROJECT_ID=
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/outside/repo/wishkaro-service-account.json

# ---- Defaults ----
DEFAULT_REMINDER_HOUR=9
DEFAULT_TIMEZONE=Asia/Kolkata

# Alternative to GOOGLE_APPLICATION_CREDENTIALS, for hosts with no filesystem to
# point at (Railway). Paste the whole service-account JSON on one line.
# When both are set, this one wins.
FIREBASE_SERVICE_ACCOUNT=

# ---- M5: wish drafting (FR-WSH-02, FR-WSH-08, FR-POS-10) ----
# SERVER-SIDE ONLY. The phone never sees this: a key in the APK is a key anyone can extract,
# and this repository is public on top of that. Keep the key OUTSIDE the repo — `~/.secrets/`
# locally, Railway's own environment for the deploy — and never paste it into a committed file.
#
# Optional, unlike the Firebase credentials above. Without it the drafting endpoint serves a
# deterministic fake: the cost ledger, the rate limit, the tone rules and every error path
# still work, and every draft is recorded as a TEMPLATE rather than as AI. The server logs a
# warning at boot so a deployment cannot serve templates while believing otherwise.
ANTHROPIC_API_KEY=

# Changing the model is a product decision with a quality cost attached — measure the real
# per-draft cost with the ledger first. Effort is set explicitly because this model's default
# is `medium` and a two-sentence greeting does not need more than `low`.
ANTHROPIC_MODEL=claude-opus-5-5
ANTHROPIC_EFFORT=low

# For the cost ledger. A fixed rate, not a live one: two rows written an hour apart have to
# be comparable. The rate used is stored on every row, so changing this never re-prices
# anything already written.
USD_INR_RATE=89

# FR-WSH-08's fair use. Counted on ATTEMPTS, not successes — a refused draft still cost money.
WISH_DRAFT_LIMIT_HOUR=15
WISH_DRAFT_LIMIT_DAY=50

# ---- Which provider serves a draft ----
# EXPLICIT, not inferred from which key is present: pasting a key in to try something must not
# silently change what every draft costs or what `source` the wish history records.
# A provider named here without its key is a BOOT FAILURE, not a quiet fall back to the fake.
#   fake      the deterministic stub. No model, no money, every draft recorded as a TEMPLATE.
#   openai    needs OPENAI_API_KEY below.
#   anthropic needs ANTHROPIC_API_KEY above. Adapter not written yet.
WISH_PROVIDER=fake

# ---- OpenAI (added 2026-11-26; D20 amended — see docs/M5_PLAN.md) ----
# D20 in REQUIREMENTS.md said "Text AI = Claude". Dipen amended it to run BOTH providers
# behind one port, so the solemn copy TBD-4 has to hand-review can be compared on real output
# from both rather than settled by picking a vendor first. Same rules as any other key:
# server-side only, outside the repo, never committed.
OPENAI_API_KEY=
# gpt-6-luna is the cheapest current tier and the one D20's own words call for ("Haiku for
# high-volume wish drafting"). Its published rates match Claude Haiku 5.5's exactly, so the
# same prompt costs the same on both and a quality difference is the only difference.
OPENAI_MODEL=gpt-6-luna
OPENAI_EFFORT=low
