# WishKaro server — copy to `.env` and fill in.
# `.env` is gitignored. This repo is PUBLIC: never commit real values.

NODE_ENV=development
PORT=3000

# ---- Datastores (match infra/docker-compose.yml) ----
DATABASE_URL=postgresql://wishkaro:wishkaro@localhost:5432/wishkaro
REDIS_URL=redis://localhost:6379

# ---- Auth ----
# The *Web* OAuth client ID from Google Cloud Console — NOT the Android one.
# The Android app requests the token; this server validates its audience against this value.
GOOGLE_CLIENT_ID=

# Generate each with: openssl rand -base64 48
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=60d

# ---- Firebase Admin (FCM) ----
# From Firebase Console → Project settings → Service accounts → Generate new private key.
# Keep the JSON file OUTSIDE this repo and point at it with an absolute path.
FIREBASE_PROJECT_ID=
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/outside/repo/wishkaro-service-account.json

# ---- Defaults ----
DEFAULT_REMINDER_HOUR=9
DEFAULT_TIMEZONE=Asia/Kolkata

# Alternative to GOOGLE_APPLICATION_CREDENTIALS, for hosts with no filesystem to
# point at (Railway). Paste the whole service-account JSON on one line.
# When both are set, this one wins.
FIREBASE_SERVICE_ACCOUNT=

# ---- M5: wish drafting (FR-WSH-02, FR-WSH-08, FR-POS-10) ----
# SERVER-SIDE ONLY. The phone never sees this: a key in the APK is a key anyone can extract,
# and this repository is public on top of that. Keep the key OUTSIDE the repo — `~/.secrets/`
# locally, Railway's own environment for the deploy — and never paste it into a committed file.
#
# Optional, unlike the Firebase credentials above. Without it the drafting endpoint serves a
# deterministic fake: the cost ledger, the rate limit, the tone rules and every error path
# still work, and every draft is recorded as a TEMPLATE rather than as AI. The server logs a
# warning at boot so a deployment cannot serve templates while believing otherwise.
ANTHROPIC_API_KEY=

# Changing the model is a product decision with a quality cost attached — measure the real
# per-draft cost with the ledger first. Effort is set explicitly because this model's default
# is `medium` and a two-sentence greeting does not need more than `low`.
ANTHROPIC_MODEL=claude-opus-5-5
ANTHROPIC_EFFORT=low

# For the cost ledger. A fixed rate, not a live one: two rows written an hour apart have to
# be comparable. The rate used is stored on every row, so changing this never re-prices
# anything already written.
USD_INR_RATE=89

# FR-WSH-08's fair use. Counted on ATTEMPTS, not successes — a refused draft still cost money.
WISH_DRAFT_LIMIT_HOUR=15
WISH_DRAFT_LIMIT_DAY=50

# ---- Which provider serves a draft ----
# EXPLICIT, not inferred from which key is present: pasting a key in to try something must not
# silently change what every draft costs or what `source` the wish history records.
# A provider named here without its key is a BOOT FAILURE, not a quiet fall back to the fake.
#   fake      the deterministic stub. No model, no money, every draft recorded as a TEMPLATE.
#   openai    needs OPENAI_API_KEY below.
#   anthropic needs ANTHROPIC_API_KEY above. Adapter not written yet.
WISH_PROVIDER=fake

# ---- OpenAI (added 2026-11-26; D20 amended — see docs/M5_PLAN.md) ----
# D20 in REQUIREMENTS.md said "Text AI = Claude". Dipen amended it to run BOTH providers
# behind one port, so the solemn copy TBD-4 has to hand-review can be compared on real output
# from both rather than settled by picking a vendor first. Same rules as any other key:
# server-side only, outside the repo, never committed.
OPENAI_API_KEY=
# gpt-6-luna is the cheapest current tier and the one D20's own words call for ("Haiku for
# high-volume wish drafting"). Its published rates match Claude Haiku 5.5's exactly, so the
# same prompt costs the same on both and a quality difference is the only difference.
OPENAI_MODEL=gpt-6-luna
OPENAI_EFFORT=low

# ---- The GLOBAL daily spend cap, in INR (REQUIREMENTS.md §10 rule 6) ----
# The two WISH_DRAFT_LIMIT_* above bound what ONE user can spend. This bounds the TOTAL.
# The distinction is the point: this repo is public, the endpoint is behind a token anybody
# can mint by signing in with Google, and every call bills a personal card — fifteen drafts
# an hour each is fair use and no limit at all across a thousand accounts.
# When the day's ledger reaches this, drafting degrades to the phone's own template rather
# than erroring, and the user is NOT told a budget was hit. It is our budget.
# ₹200 ≈ 13,000 drafts on the cheap tier, or ~320 on Opus.
AI_DAILY_SPEND_CAP_INR=200

# ---- M6: posters (FR-POS-01..13, REQUIREMENTS.md §10) ----

# Where generated bytes live. EXPLICIT, like WISH_PROVIDER: a store chosen by which
# credentials happen to be present is a store that changes when somebody pastes a key in.
#   local  a directory on disk. The committed default, so CI and a fresh clone work with no
#          cloud account. NOT durable — Railway replaces the container on every deploy, so
#          every poster and every cached theme background goes with it.
#   r2     accepted here and THROWS at boot. There is no R2 account, no bucket and no
#          credential; REQUIREMENTS.md §8, §11 and §14 all name R2 and none of them is
#          configured. Raised in docs/M6_PLAN.md §3.2 rather than stubbed, for the same
#          reason the Anthropic adapter was never written: a branch nothing can take and
#          nothing can test is a dead path that survives until the day it runs.
BLOB_STORE=local
BLOB_LOCAL_ROOT=./.storage

# HMAC key for the short-lived blob URLs §11 requires. Its OWN secret rather than a reuse of
# JWT_ACCESS_SECRET: a blob URL is a capability for one object, handed to another app through
# a share sheet, and the thing that mints it must not also be able to mint a session.
# Generate with: openssl rand -base64 48
# Falls back to JWT_ACCESS_SECRET when empty, so a dev server boots. Set it in production.
BLOB_SIGNING_SECRET=

# ---- Background artwork (D21, FR-POS-01b) ----
# gpt-image-1 is billed PER IMAGE, not per token. The cost shape is nothing like wish
# drafting: "try another" pressed four times is four whole images, and a retry loop with a
# bug in it is a bill rather than a log line.
#   fake    a deterministic placeholder image. No model, no money. The committed default.
#   openai  needs OPENAI_API_KEY above. A provider named without its key is a BOOT FAILURE.
IMAGE_PROVIDER=fake
OPENAI_IMAGE_MODEL=gpt-image-1
# The quality tier is what decides the per-image price — §10's table spans "₹1–15 depending
# on quality tier", so this is the single most expensive configuration value in the app.
OPENAI_IMAGE_QUALITY=low

# ---- FR-POS-11's per-user limits ----
# NOT the drafting ceilings. Fifteen images an hour would be a day's budget from one person
# in twenty minutes. A cache HIT consumes no slot at all: FR-POS-03's economic argument is
# that the common path costs nothing, and rationing the cheap path like the expensive one
# throws that away. Counted on ATTEMPTS — a refused image still cost money.
POSTER_LIMIT_HOUR=5
POSTER_LIMIT_DAY=20

# ---- Moderation (REQUIREMENTS.md §10 rule 7, FR-POS-12) ----
#   fake    records UNCHECKED and allows. Honest: no verdict was reached. It does NOT record
#           ALLOWED, because a generation nobody moderated has not been allowed by anything.
#   openai  needs OPENAI_API_KEY. Until one exists, rule 7 is STRUCTURALLY met and not
#           actually exercised, and docs/M6_VERIFY.md says so in those words.
# The deterministic input check on the user's own typed text runs under both settings.
MODERATION_PROVIDER=fake
