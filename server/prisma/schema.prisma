// WishKaro — M0 schema.
//
// Scope note: M0 ships only the tables the walking skeleton needs. Everything here is
// shaped so the full v1 schema in docs/REQUIREMENTS.md §8 is a pure ADDITION later —
// new tables and new columns — never an alteration of a column that already exists.
//
// Enums therefore carry their FULL v1 value sets today even though M0 only ever writes
// BIRTHDAY / CELEBRATORY / D0. Later milestones add behaviour, not migrations.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums — full v1 value sets (REQUIREMENTS.md §8)
// ---------------------------------------------------------------------------

enum EventType {
  BIRTHDAY
  WEDDING_ANNIVERSARY
  ENGAGEMENT_ANNIVERSARY
  DEATH_ANNIVERSARY
  CUSTOM
}

/// Derived from EventType, never set independently. DEATH_ANNIVERSARY is SOLEMN;
/// everything else is CELEBRATORY (FR-EVT-01a). Gates tone, templates, copy and the
/// entire gift surface in later milestones — it is not cosmetic.
enum Sentiment {
  CELEBRATORY
  SOLEMN
}

/// v1 only ever writes GREGORIAN (OD-12). The column exists so lunar/tithi dates can be
/// added later without a migration (FR-EVT-07).
enum CalendarSystem {
  GREGORIAN
}

/// Reminder ladder steps (FR-REM-03). M0 shipped D0 only; M2 adds D7 and D1 for real.
///
/// DIGEST is not a rung and REQUIREMENTS.md §8 does not list it. It is here because a digest
/// (FR-REM-08) is still a reminder row — it needs a schedule, a status, a dedupe key and a
/// delivery outcome exactly like any other — and the alternative was to write digests as D0
/// rows distinguishable only by a key prefix, which is the kind of implicit encoding that
/// survives until someone writes `where: { offset: 'D0' }` and silently sweeps up every
/// digest in the table. Adding a value to a Postgres enum is a pure addition.
enum ReminderOffset {
  D7
  D1
  D0
  DIGEST
}

enum ReminderChannel {
  FCM
  LOCAL
}

enum ReminderStatus {
  PENDING
  SENT
  DELIVERED
  FAILED
  SUPPRESSED
}

enum DevicePlatform {
  ANDROID
  IOS
}

/// Progressive profile enrichment (FR-PPL-04). Full v1 value set now; M1 collects all four.
/// Gift suggestions in M8 are only as good as what accumulates here, which is why the table
/// exists two milestones before the feature that reads it.
enum TraitKind {
  HOBBY
  LIKE
  DISLIKE
  BUDGET_BAND
}

/// Where a trait came from. M1 only ever writes USER; IMPORT is M3 and INFERRED is M5+.
/// Kept distinct because an inferred trait must never be shown as though the user said it.
enum TraitSource {
  USER
  IMPORT
  INFERRED
}

/// Tone of a drafted wish (FR-WSH-03, FR-WSH-09).
///
/// SIX values, not five. FR-WSH-03 lists the celebratory set — Warm, Funny, Respectful,
/// Short, Poetic — and FR-WSH-09 lists the solemn one — Respectful, Short, Heartfelt. The two
/// overlap on two values and HEARTFELT exists only on the solemn side, so the union is six and
/// neither set is a subset of the other.
///
/// Which tones are legal for which sentiment is NOT expressed here, because an enum cannot
/// express it: a SOLEMN wish tagged FUNNY is a valid enum value and an invalid record. That
/// rule lives in modules/wishes/tone-rules.ts, is enforced on every write, and is held to the
/// same table of cases as the client's copy — docs/fixtures/wish-tones.json. See
/// docs/M5_PLAN.md §5.2.
enum WishTone {
  WARM
  FUNNY
  RESPECTFUL
  SHORT
  POETIC
  HEARTFELT
}

/// FR-WSH-03. Hindi here means a wish written in Hindi — it is not the Hindi UI
/// localisation, which is v1.1 and a different thing entirely.
enum WishLanguage {
  ENGLISH
  HINDI
  HINGLISH
}

/// Where the user took the message (FR-WSH-05, FR-HIS-01).
///
/// Recorded, never acted on: FR-WSH-06 means the app hands a prepared message to another app
/// and that app sends it. This column says which door the message went through, and the app
/// does not actually know it arrived — which is exactly why FR-WSH-07 has to ask.
enum WishChannel {
  WHATSAPP
  SMS
  SHARE
  COPY
}

/// Who wrote the words.
///
/// Not cosmetic. AI means the model drafted it; TEMPLATE means the phone's own offline
/// template did, because there was no network or the model declined (docs/M5_PLAN.md §4);
/// USER means the person typed it themselves. A history row is only as good as the question
/// "was this us or them", and next year's no-repeat rule reads differently for each.
enum WishSource {
  AI
  TEMPLATE
  USER
}

// ---------------------------------------------------------------------------
// M6 — AI posters (FR-POS-01..13, REQUIREMENTS.md §10)
// ---------------------------------------------------------------------------

/// What a stored binary IS (REQUIREMENTS.md §8's `asset.kind`).
///
/// VIDEO is in §8's list and is deliberately absent here: it is M10, nothing can produce one,
/// and an enum value nothing writes is a claim that a feature exists. Adding a value to a
/// Postgres enum is a pure addition, so M10 pays nothing for this.
enum AssetKind {
  /// A composited poster. A user's media: FR-SET-06 purges these after 180 days.
  POSTER
  /// A photo the user uploaded of a person. FR-SET-06 purges these after 90 days unless
  /// attached to a saved poster.
  SOURCE_PHOTO
}

/// FR-SET-06's "both user-overridable to keep" (M9).
///
/// An enum rather than a nullable `expires_at`, which is what M6's comment proposed. Two
/// reasons, both found by trying to write the un-keep path: a null date cannot be told apart
/// from "no policy was ever set", and nulling it destroys the deadline, so switching back to
/// AUTO would have to invent a new one from today — handing every kept-then-unkept asset
/// another full 90 or 180 days. See docs/M9_PLAN.md C2.
enum AssetRetention {
  /// Swept on `expires_at`, subject to the per-kind rules in `RetentionService`.
  AUTO
  /// Never swept. The user said so.
  KEEP
}

/// The three output formats (FR-POS-05). Named rather than stored as "1080x1920" so that a
/// typo cannot invent a fourth, and so the compositor's switch is exhaustive.
enum PosterFormat {
  /// 1080×1920. WhatsApp status, and the DEFAULT.
  STATUS
  /// 1080×1080.
  SQUARE
  /// 1200×630. Link preview.
  LINK
}

/// Which family a theme belongs to (FR-POS-13).
///
/// TWO COLLECTIONS, never one with a branch. The same arrangement `domain/Tone.kt` uses on the
/// client, and for the reason its comment gives: a conditional is a thing someone can forget,
/// and a set you have to pick is a thing the compiler makes you pick. FR-POS-13 asks for
/// celebratory themes to be filtered OUT of the picker for a solemn occasion rather than
/// merely ranked lower, and a single collection with a `solemn` boolean is how "ranked lower"
/// happens by accident.
///
/// Mirrors `Sentiment` deliberately but is NOT the same type: a sentiment is a fact about an
/// occasion and a family is a property of a picture. They map one to one today and the
/// mapping lives in exactly one function.
enum ThemeFamily {
  CELEBRATORY
  SOLEMN
}

/// Where one poster job got to (FR-POS-09's "visible progress state").
///
/// §8's `generation` sketch has a `status` with no values named. These are the five a client
/// can actually be shown something for.
enum GenerationStatus {
  /// Accepted and on the queue. The app shows progress from here.
  QUEUED
  RUNNING
  SUCCEEDED
  /// The pipeline failed. The app degrades; the ledger still has its rows.
  FAILED
  /// Input or output moderation refused it (§10 rule 7, FR-POS-12). Distinct from FAILED
  /// because the user-facing answer differs and because "how often does moderation bite" is
  /// a question worth being able to ask of this table.
  BLOCKED
}

/// What moderation said about a generation (§10 rule 7, FR-POS-12).
///
/// UNCHECKED is a real, honest value and the default. There is no moderation key on this
/// machine, so a generation served by the fake moderator records what actually happened
/// rather than claiming a verdict nobody reached — the same reason `WishSource.TEMPLATE`
/// exists instead of recording a template as AI.
enum ModerationVerdict {
  UNCHECKED
  ALLOWED
  BLOCKED
}

// ---------------------------------------------------------------------------
// Tables
// ---------------------------------------------------------------------------

model User {
  id        String  @id @default(uuid(7))
  googleSub String  @unique @map("google_sub")
  email     String
  name      String?
  photoUrl  String? @map("photo_url")
  locale    String?
  /// IANA zone, e.g. "Asia/Kolkata". Reminders fire in the owner's CURRENT timezone;
  /// changing this reschedules every PENDING reminder (FR-EVT-08).
  timezone  String  @default("Asia/Kolkata")

  // --- M2: reminder settings (FR-REM-03, FR-REM-08, FR-REM-09) -------------------------
  //
  // Per-user and synced, so a reinstall does not lose them. REQUIREMENTS.md §8's `user`
  // sketch predates the reminder engine and lists none of these; §8 is corrected to match.

  /// Local hour the morning-of reminder fires. Overridable per person (FR-REM-03).
  reminderHour Int @default(9) @map("reminder_hour")

  /// The three rungs, individually toggleable (FR-REM-03). A SOLEMN event never gets D7
  /// whatever this says — see ladderFor() in modules/reminders/ladder.ts (FR-REM-11).
  ladderD7 Boolean @default(true) @map("ladder_d7")
  ladderD1 Boolean @default(true) @map("ladder_d1")
  ladderD0 Boolean @default(true) @map("ladder_d0")

  /// Quiet hours (FR-REM-09), as LOCAL HOURS rather than instants: the window is a property
  /// of the user's day, not of any moment in time. Null together or set together — a
  /// half-set window is rejected at the API, because "quiet from 22:00 until unspecified" has
  /// no safe interpretation and the unsafe one silences the app forever.
  quietHoursStart Int? @map("quiet_hours_start")
  quietHoursEnd   Int? @map("quiet_hours_end")

  /// Digest mode (FR-REM-08). When on it replaces the WHOLE ladder, not just morning-of —
  /// see docs/M2_PLAN.md §2.1. Per-event reminders for that user are suppressed, and one
  /// digest row is materialised per local day that has anything to say.
  digestEnabled Boolean @default(false) @map("digest_enabled")
  digestHour    Int     @default(9) @map("digest_hour")

  /// Bumped on every settings write. Settings are not a sync cursor entity — there is one
  /// row per user and paging it would be absurd — so the blob rides on the /v1/sync pull and
  /// this column is what decides whose copy is newer.
  settingsUpdatedAt DateTime @default(now()) @map("settings_updated_at")

  createdAt DateTime  @default(now()) @map("created_at")
  deletedAt DateTime? @map("deleted_at")

  people        Person[]
  traits        PersonTrait[]
  events        Event[]
  reminders     Reminder[]
  devices       Device[]
  refreshTokens RefreshToken[]
  wishes        Wish[]
  aiUsage       AiUsage[]
  assets        Asset[]
  generations   Generation[]
  posters       Poster[]
  reports       ContentReport[]

  @@index([email])
  @@map("user")
}

model Person {
  id              String  @id @default(uuid(7))
  userId          String  @map("user_id")
  displayName     String  @map("display_name")
  relationToOwner String? @map("relation_to_owner")
  /// The person record representing the signed-in user themselves (FR-AUTH-04).
  isSelf          Boolean @default(false) @map("is_self")

  // --- M1: optional profile fields, all progressively collected (FR-PPL-04) ------------
  /// Reserved for the R2 object key. NOTHING writes this in M1 — uploads are M6. The column
  /// exists now so the feature is a code change later rather than a migration.
  photoKey String? @map("photo_key")
  /// Free text, deliberately not an enum: an enum of genders is a product decision this app
  /// has no reason to make, and gift logic in M8 reads traits rather than this field.
  gender   String?
  phone    String?
  email    String?
  notes    String?

  /// Set when a DEATH_ANNIVERSARY is created for this person (FR-EVT-04), and it changes the
  /// sentiment of EVERY event they own — see sentimentFor() in modules/events/derived.ts.
  /// Never trusted from a client on an event write; derived there.
  isDeceased Boolean @default(false) @map("is_deceased")

  /// DERIVED from a known birth year implying age < 18 (FR-PPL-09). Impossible to set from a
  /// client. Flagged records are excluded from profiling and from the completeness nudge.
  isMinor Boolean @default(false) @map("is_minor")

  /// DERIVED 0..100 (FR-PPL-05). Weights live in ONE place: COMPLETENESS_WEIGHTS.
  completenessScore Int @default(0) @map("completeness_score")

  /// M2: this person's reminders fire at this local hour instead of the user's global one
  /// (FR-REM-03). Null means "use the global hour" — not 0, which is a real hour someone
  /// might choose. Ignored entirely while digest mode is on, since a digest has one hour for
  /// the whole day by definition.
  reminderHourOverride Int? @map("reminder_hour_override")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @default(now()) @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  user    User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  events  Event[]
  traits  PersonTrait[]
  wishes  Wish[]
  assets  Asset[]
  posters Poster[]

  /// Drives the sync cursor: (updatedAt, id) is the monotonic ordering.
  @@index([userId, updatedAt, id])
  @@map("person")
}

/// Progressive profile enrichment (FR-PPL-04), as chips in the UI.
///
/// `updatedAt` and `deletedAt` are not in REQUIREMENTS.md §8's sketch, which has only
/// `created_at`. Both are required here: traits sync like everything else, and sync needs a
/// monotonic ordering key and a tombstone. Adding them now is free; retrofitting them would
/// mean a migration and a second code path.
model PersonTrait {
  id       String @id @default(uuid(7))
  personId String @map("person_id")
  /// Denormalised from person, exactly as `event.user_id` is: the sync cursor scans by owner
  /// and ordering, and a join to person for every page would be the one slow query in the
  /// hot path.
  userId   String @map("user_id")

  kind   TraitKind
  value  String
  source TraitSource @default(USER)

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @default(now()) @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  person Person @relation(fields: [personId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Drives the sync cursor for traits, the third entity after person and event.
  @@index([userId, updatedAt, id])
  @@index([personId])
  @@map("person_trait")
}

model Event {
  id       String @id @default(uuid(7)) @map("id")
  personId String @map("person_id")
  userId   String @map("user_id")

  type      EventType
  sentiment Sentiment

  /// Day and month are always known. Year is nullable — "year unknown" birthdays are a
  /// first-class case, not a UI concern (FR-EVT-02).
  day   Int
  month Int
  year  Int?

  calendarSystem CalendarSystem @default(GREGORIAN) @map("calendar_system")

  /// User-supplied name for a CUSTOM event (FR-EVT-06). Null for every other type — a
  /// BIRTHDAY does not need a label and must not be given one.
  label String?

  /// Stops reminders without deleting the event. Distinct from deletedAt on purpose: a muted
  /// event still appears on the person, still counts towards their profile, and can be
  /// un-muted; a deleted one cannot.
  isMuted Boolean @default(false) @map("is_muted")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @default(now()) @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  person      Person            @relation(fields: [personId], references: [id], onDelete: Cascade)
  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  occurrences EventOccurrence[]

  @@index([userId, updatedAt, id])
  @@index([personId])
  @@map("event")
}

/// One materialised occurrence of an event, per calendar year.
///
/// The effective date is always COALESCE(override_date, occurs_on) — wired from the first
/// line of code even though nothing writes override_date in M0 (OD-16 / FR-EVT-10).
model EventOccurrence {
  id      String @id @default(uuid(7))
  eventId String @map("event_id")

  /// The year this row materialises. Unique per event, so re-running the materialiser is
  /// idempotent AND editing the event's date updates this row rather than orphaning it.
  occurrenceYear Int @map("occurrence_year")

  /// Base date computed from the event in the owner's timezone. For a 29 Feb birthday in a
  /// non-leap year this is 28 Feb (FR-EVT-09).
  occursOn     DateTime  @map("occurs_on") @db.Date
  /// Moves a single year's occurrence without touching the base event (FR-EVT-10).
  overrideDate DateTime? @map("override_date") @db.Date

  /// DERIVED (FR-EVT-03). Materialised here rather than recomputed per push, and present in
  /// REQUIREMENTS.md §8 — M0 omitted it because nothing could produce one yet. For a
  /// DEATH_ANNIVERSARY this is a plain year count ("12 years") and NEVER a celebratory
  /// milestone name: no Silver, no Golden.
  milestoneLabel String? @map("milestone_label")

  computedAt DateTime @default(now()) @map("computed_at")

  event     Event      @relation(fields: [eventId], references: [id], onDelete: Cascade)
  reminders Reminder[]

  @@unique([eventId, occurrenceYear])
  /// Drives the scheduler (REQUIREMENTS.md §8 indexing notes).
  @@index([occursOn])
  @@map("event_occurrence")
}

model Reminder {
  id String @id @default(uuid(7))

  /// NULLABLE by design. POST /v1/reminders/test must work before any person, event or
  /// occurrence exists — that is the whole point of building it first. A null FK means a
  /// self-test reminder (M0) or, from M2, a digest row, which belongs to a user and a day
  /// rather than to any single occurrence. See docs/M0_PLAN.md §1.2.
  eventOccurrenceId String? @map("event_occurrence_id")
  userId            String  @map("user_id")

  offset         ReminderOffset
  /// Always UTC. User-facing times are derived in the owner's timezone, never stored.
  /// Quiet hours (FR-REM-09) are applied HERE, when the row is written, so that both
  /// delivery paths inherit the deferral from one implementation.
  scheduledAtUtc DateTime       @map("scheduled_at_utc")

  /// M2: the channel that actually DELIVERED this reminder, not the one it was scheduled on.
  ///
  /// It cannot mean "scheduled on" while `dedupe_key` is UNIQUE across the table, because
  /// then one rung would need an FCM row and a LOCAL row sharing a key. The two paths are
  /// one row racing to deliver it: created FCM, flipped to LOCAL when the client reports
  /// that its own alarm got there first. That also makes the G1 reliability metric one
  /// query — count(channel = LOCAL) / count(*) IS the FCM failure rate (docs/M2_PLAN.md
  /// §2.2).
  channel ReminderChannel @default(FCM)
  status  ReminderStatus  @default(PENDING)

  /// Unique across the table, and from M2 derivable on BOTH sides — see dedupeKeyFor() in
  /// modules/reminders/dedupe-key.ts. The client claims it before drawing a notification, so
  /// a server retry, a late push and the local-alarm fallback all collapse into one.
  dedupeKey String    @unique @map("dedupe_key")
  sentAt    DateTime? @map("sent_at")

  /// M2, FR-REM-10. When the client told us what happened, and what it said. Null means no
  /// device has reported on this reminder — which is itself the signal the G1 metric is
  /// made of, so it is distinct from "reported as not shown".
  deliveredAt     DateTime? @map("delivered_at")
  deliveryOutcome String?   @map("delivery_outcome")

  createdAt DateTime @default(now()) @map("created_at")

  eventOccurrence EventOccurrence? @relation(fields: [eventOccurrenceId], references: [id], onDelete: Cascade)
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Drives the send loop (REQUIREMENTS.md §8 indexing notes).
  @@index([scheduledAtUtc, status])
  @@index([userId])
  @@map("reminder")
}

model Device {
  id       String         @id @default(uuid(7))
  userId   String         @map("user_id")
  fcmToken String         @unique @map("fcm_token")
  platform DevicePlatform
  /// Last timezone this device reported. A change here reschedules pending reminders.
  timezone String?

  lastSeenAt DateTime @default(now()) @map("last_seen_at")
  createdAt  DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("device")
}

/// Not in REQUIREMENTS.md §8 — added in M0 because a *rotating* refresh token is
/// server-side state by definition: rotation means knowing which token is current and
/// invalidating its predecessor. Stored hashed, so a database dump yields nothing usable.
/// See docs/M0_PLAN.md §1.2.
model RefreshToken {
  id        String @id @default(uuid(7))
  userId    String @map("user_id")
  /// SHA-256 of the token. The plaintext is only ever in the response body.
  tokenHash String @unique @map("token_hash")

  expiresAt    DateTime  @map("expires_at")
  revokedAt    DateTime? @map("revoked_at")
  /// Set when this token is rotated, so a replayed old token is detectable.
  replacedById String?   @map("replaced_by_id")

  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_token")
}

/// What the user actually sent, per person per occasion (FR-HIS-01, FR-WSH-07, FR-PPL-07).
///
/// M5's floor. FR-WSH-02's "must not repeat" cannot be built, tested or demonstrated against
/// a table that does not exist, so this lands before the composer does — see
/// docs/M5_PLAN.md §2 and docs/BUILD_PROMPT_M5.md, "Why history goes first".
///
/// A SYNCED entity, the fourth after person, event and trait, and it does the same three
/// things they do: last-write-wins per record on `updatedAt`, soft delete as a tombstone, and
/// a monotonic `(updatedAt, id)` cursor. The alternative — local-only, on the grounds that
/// this is the user's own record of their own words — lost on two facts: the server builds
/// the prompt, so it is the side that needs the history; and a reinstall would erase it,
/// which for the thing FR-HIS-03 calls "the retention moat" is not survivable.
///
/// `updatedAt` will almost always equal `createdAt`. A wish is near-append-only: it is
/// written once, when the user answers "did you send it?", and then edited approximately
/// never. The column is here because the sync cursor orders on it, not because anybody
/// expects it to move.
model Wish {
  id       String @id @default(uuid(7))
  userId   String @map("user_id")
  /// Denormalised from person, as `event.user_id` and `person_trait.user_id` already are:
  /// the sync cursor scans by owner and ordering, and a join per page would be the one slow
  /// query in the hot path.
  personId String @map("person_id")

  // --- which occasion this was ----------------------------------------------------------

  /// The occasion's identity is (person, type, year) — see the `@@index` below.
  ///
  /// FR-HIS-01 says "per person per year", which does not identify a row: somebody can have a
  /// birthday and a wedding anniversary in the same year. Read here as per person, per event
  /// TYPE, per year, flagged in docs/M5_PLAN.md §2.4 rather than silently chosen.
  eventType      EventType @map("event_type")
  occurrenceYear Int       @map("occurrence_year")

  /// DERIVED from the person's `is_deceased` and the event type by sentimentFor(), exactly as
  /// `event.sentiment` is. Refused on the way up: the write schema is `.strict()`, so a client
  /// that sends it gets a 400 naming the field rather than having it quietly dropped.
  ///
  /// Stored rather than re-derived on read because it is a fact about the moment the message
  /// was sent. A person marked deceased in 2027 did not receive a solemn message in 2025, and
  /// a history that rewrote itself would say they did.
  sentiment Sentiment

  /// A SOFT reference to the event row. Deliberately NOT a foreign key, and nullable.
  ///
  /// Three reasons, in order of weight (docs/M5_PLAN.md §2.3):
  ///
  ///   1. Deleting an event must not delete the history. The commonest repair in this app is
  ///      "that date was wrong" — delete, re-add. Under a cascading FK, fixing your mother's
  ///      birthday in 2026 would destroy the record of what you sent her in 2024. A fact
  ///      about the past cannot be owned by a row the user is free to replace.
  ///   2. It keeps a wish's only push dependency its PERSON. The client's planPages() packs a
  ///      person together with their events and traits; a real FK to event would need a unit
  ///      that spans both, which that function does not express.
  ///   3. The no-repeat query does not use it.
  ///
  /// Kept at all so a later milestone can tighten the CUSTOM-event ambiguity named in §2.3
  /// without a migration.
  eventId String? @map("event_id")

  // --- what was sent (FR-HIS-01) --------------------------------------------------------

  /// The message as it was handed over, AFTER the user's edits. Never logged — §11 bans PII
  /// in logs and this is prose about a named person.
  messageText String       @map("message_text")
  tone        WishTone
  language    WishLanguage
  channel     WishChannel
  source      WishSource

  /// The poster that went with this message (FR-HIS-01, "and the poster used").
  ///
  /// Reserved and unwritten in M5; **M6 is what writes it**, and it is also the reason a
  /// poster is not a fifth synced entity. A wish syncs, so the reference to a poster syncs
  /// with it for free — docs/M6_PLAN.md §4.
  ///
  /// A plain nullable column with no foreign key, for the same first reason `eventId` above
  /// has none: deleting a poster must not delete the record that a message was sent. What
  /// you said to somebody in 2026 is a fact about the past; the picture is an attachment to
  /// it, and tidying up the attachment cannot be allowed to destroy the fact.
  posterId String? @map("poster_id")

  /// When the user said yes, not when the draft was produced.
  ///
  /// FR-WSH-07 puts the question AFTER the hand-off, and the distinction is the whole point:
  /// a draft that was generated and never sent is not history, must not suppress next year's
  /// draft, and must not appear on the person screen. Regenerate writes nothing either.
  sentAt DateTime @map("sent_at")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @default(now()) @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  person Person @relation(fields: [personId], references: [id], onDelete: Cascade)

  /// Drives the sync cursor, the fourth entity after person, event and trait.
  @@index([userId, updatedAt, id])
  /// Drives FR-WSH-02's no-repeat rule and FR-PPL-07's history list.
  @@index([personId, eventType, occurrenceYear])
  @@map("wish")
}

/// One row per model call. FR-POS-10, which calls it non-negotiable.
///
/// M5 is where it starts even though FR-POS-10 lives under posters, because wish text is the
/// first thing in this app that costs money per use — raised in docs/M5_PLAN.md §6.3 rather
/// than quietly resolved.
///
/// Written in a `finally`, on EVERY outcome including a refusal, an error and a timeout: a
/// call that produced tokens cost money whether or not the user got anything. A row that
/// cannot be written fails the request, because the alternative — serve the draft, lose the
/// row — is how a cost ledger quietly becomes a sample.
///
/// Not synced and never sent to a client. It is ours.
model AiUsage {
  id     String  @id @default(uuid(7))
  /**
   * NULLABLE since M9, and `SetNull` rather than `Cascade` below.
   * **This is the one place DPDP's erasure right and §10 rule 2 collide**, and the schema had
   * already resolved it in rule 2's disfavour without anybody deciding: `onDelete: Cascade`
   * meant the first `user.delete()` anybody wrote would silently destroy the cost ledger that
   * rule 2 and FR-POS-10 both call non-negotiable.
   * Dipen's decision, taken after being shown the conflict rather than finding it in a diff:
   * **anonymise, do not erase.** This table holds what a call cost — provider, model, tokens,
   * INR — and not one character the user typed. With the id nulled, no row identifies anybody,
   * the erasure right is satisfied in substance, and "what does a user cost per year" is still
   * answerable in aggregate. What is given up, stated: per-user cost attribution for deleted
   * accounts. docs/M9_PLAN.md decision 3.
   */
  userId String? @map("user_id")

  /// Which surface spent the money. "wish_draft" in M5; M6 writes posters, M8 gift ideas.
  /// A string rather than an enum so a new feature is not a migration.
  feature  String
  provider String
  /// The model that ACTUALLY served it. A server-side fallback changes this, which is the
  /// only way to find out afterwards that one happened.
  model    String
  /// OK | REFUSED | ERROR | TIMEOUT.
  outcome  String

  /// Four counts, not two. Cache reads are an order of magnitude cheaper than fresh input,
  /// and a ledger that cannot see the difference cannot answer whether caching is working —
  /// which is the one question prompt caching has to be checked against rather than assumed.
  inputTokens      Int @map("input_tokens")
  outputTokens     Int @map("output_tokens")
  cacheReadTokens  Int @map("cache_read_tokens")
  cacheWriteTokens Int @map("cache_write_tokens")

  /// The rate and the conversion AS THEY WERE. Stored per row so that changing the price
  /// table or the exchange rate later does not silently re-price what last month cost.
  costUsd        Decimal @map("cost_usd") @db.Decimal(12, 6)
  usdInrRate     Decimal @map("usd_inr_rate") @db.Decimal(10, 4)
  costInr        Decimal @map("cost_inr") @db.Decimal(12, 4)
  pricingVersion String  @map("pricing_version")

  /// WHICH PROMPT produced this (REQUIREMENTS.md §10 rule 4).
  ///
  /// The rule is "prompts are versioned files in the repo, not string literals scattered
  /// through services". One file was the harder half and M5 had it; the version was missing,
  /// and without it a ledger row cannot be tied back to the words that produced it.
  ///
  /// That is not bookkeeping. FR-WSH-09 and TBD-4 have Dipen hand-reviewing solemn copy, and
  /// a review of output nobody can trace to a prompt revision cannot be re-run after the
  /// prompt changes — so the review silently stops meaning anything the first time somebody
  /// edits a line of it.
  ///
  /// Rows written before this column default to "unversioned", which is true of them.
  promptVersion String @default("unversioned") @map("prompt_version")

  /// Which JOB this call belonged to, when it belonged to one (M6).
  ///
  /// Nullable because M5's wish drafts have no generation row and never will: a draft is one
  /// call and nothing else, so wrapping it in a job would be a row per row. A poster is a job
  /// that makes zero, one or two calls — see `Generation` for why those are two tables.
  generationId String? @map("generation_id")

  createdAt DateTime @default(now()) @map("created_at")

  user       User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  generation Generation? @relation(fields: [generationId], references: [id], onDelete: SetNull)

  /// "What does one user cost per year" — the question M7's pricing is built on.
  @@index([userId, createdAt])
  /// "What does this feature cost" — the question M6 needs answered before it prices posters.
  @@index([feature, createdAt])
  /// `createdAt` ALONE, for the global daily spend cap (§10 rule 6).
  ///
  /// The two indexes above both lead on another column, so neither can range-scan on
  /// `created_at`. Measured on 200,000 rows before this index existed, the cap's
  /// `SUM(cost_inr) WHERE created_at >= $startOfDay` read **1,465 buffers to return 227
  /// rows** — a full index scan using the date as a filter, so the work grew with every row
  /// the table had ever held rather than with one day's.
  ///
  /// That is on the hot path and on the wrong side of it: `isCapped()` runs BEFORE the
  /// per-user rate limiter, so it also ran for every request the limiter was about to
  /// reject. A rail meant to stop a runaway was the most expensive thing in the request and
  /// got slower daily — and on a public endpoint behind a token anybody can mint, a cheap
  /// request that forces a full scan is also the shape somebody abuses.
  @@index([createdAt])
  /// "Which calls belonged to this job." One poster generation makes ZERO model calls on a
  /// cache hit, one on a copy-only path and two on a full miss, so this is one-to-many and
  /// the join has to be indexed from this side.
  @@index([generationId])
  @@map("ai_usage")
}

// ---------------------------------------------------------------------------
// M6 — posters (FR-POS-01..13)
// ---------------------------------------------------------------------------

/// One stored binary. REQUIREMENTS.md §8's `asset`.
///
/// §8 calls the column `r2_key`. It is `blob_key` here because the store is a PORT: there is
/// no Cloudflare R2 account, no bucket and no credentials on this machine or in `env.ts`,
/// and naming a column after one vendor's product is how a swap becomes a migration. See
/// `media/blob-store.ts` and docs/M6_PLAN.md §3.2 — this is raised there rather than treated
/// as settled, because §8, §11 and §14 all name R2 and none of them is configured.
model Asset {
  id       String  @id @default(uuid(7))
  userId   String  @map("user_id")
  /// Null for an asset that is not about anybody — a cached theme background is NOT one of
  /// these (it has its own table; see ThemeCache and docs/M6_PLAN.md §3.6).
  personId String? @map("person_id")

  kind AssetKind

  /// The key in whichever blob store is configured. Opaque to everything but the store.
  blobKey     String @map("blob_key")
  contentType String @map("content_type")
  bytes       Int
  width       Int?
  height      Int?

  /// FR-SET-06: source photos purged after 90 days unless attached to a saved poster,
  /// generated media after 180 days with a warning.
  ///
  /// M6 wrote this and did not sweep it; M9 is the sweep. M6's comment here said "a null means
  /// keep", which M9 replaced with `retention` below — see docs/M9_PLAN.md C2. Overloading the
  /// date made "kept" indistinguishable from "no policy was ever set", and threw away the
  /// information needed to UN-keep.
  expiresAt DateTime? @map("expires_at")

  /// FR-SET-06's "both user-overridable to keep" (M9).
  ///
  /// KEEP is never swept, whatever `expires_at` says. The date is left alone rather than
  /// nulled, so switching back to AUTO restores the original deadline instead of inventing a
  /// new one from today — which would quietly grant every kept-then-unkept asset another full
  /// 90 or 180 days.
  retention AssetRetention @default(AUTO)

  /// FR-SET-06's "with a warning", and the only way that clause can be ENFORCED rather than
  /// attempted (M9).
  ///
  /// The sweep refuses to purge generated media unless this is set and at least
  /// RETENTION_WARNING_DAYS old. So a warning is not a notification the job sends and hopes
  /// about — it is a precondition of deletion, and a deployment whose job was switched off for
  /// a month still gives every user the full notice period before anything is destroyed.
  ///
  /// Source photos have no warning clause in FR-SET-06 and are swept on the date alone.
  purgeWarnedAt DateTime? @map("purge_warned_at")

  /// When the BYTES went. The row stays.
  ///
  /// Deleting the row would take the poster with it (`Poster.asset` is Cascade) and leave
  /// `person.photo_key` pointing at nothing. Keeping it means the history of what existed
  /// survives a retention purge, which is the difference between retention and deletion:
  /// retention removes the media, account deletion removes the record too.
  purgedAt DateTime? @map("purged_at")

  createdAt DateTime  @default(now()) @map("created_at")
  deletedAt DateTime? @map("deleted_at")

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  person    Person?  @relation(fields: [personId], references: [id], onDelete: SetNull)
  posters   Poster[] @relation("PosterOutput")
  /// The posters this asset was the SOURCE PHOTO for (M9). See `Poster.sourceAsset`.
  sourceFor Poster[] @relation("PosterSource")

  @@index([userId, createdAt])
  @@index([personId])
  /// Drives M9's retention sweep. Partial in spirit — most rows have a date.
  @@index([expiresAt])
  /// The sweep's actual predicate: un-purged rows whose date has passed. `purged_at` leads
  /// because it eliminates everything already dealt with, which is most of the table after a
  /// deployment has been running a year.
  @@index([purgedAt, expiresAt])
  @@map("asset")
}

/// Pre-generated background artwork, cached by theme key and reused (FR-POS-03, §10 rule 5).
///
/// **`theme_key` is UNIQUE, and §8's indexing note says why in one sentence: "theme_cache
/// (theme_key) must be unique or caching silently fails."** Without the constraint a race
/// between two misses for the same key inserts two rows, the second lookup picks one of them
/// arbitrarily, and the hit rate the entire economic thesis rests on becomes unmeasurable
/// while looking fine.
///
/// The key is the five-part tuple FR-POS-03 names — (theme, event type, milestone, palette,
/// aspect ratio) — composed by `themeKeyFor()` in `posters/theme-key.ts` so that the string
/// is built in exactly one place.
///
/// **Never swept.** §10 rule 5 says "reused indefinitely" and FR-SET-06 purges generated
/// media after 180 days; those collide only if the two kinds of image are one kind, and they
/// are not. A cached background is PRODUCT ART, owned by us and shared across every user. A
/// composited poster is a USER'S MEDIA, about a named person. They are two tables with two
/// lifetimes on purpose — a retention job that could not tell them apart would delete the
/// cache, every subsequent poster would become a live generation, and the bill would go up
/// with nothing on screen having changed. docs/M6_PLAN.md §3.6.
model ThemeCache {
  id       String @id @default(uuid(7))
  themeKey String @unique @map("theme_key")

  /// The theme this is artwork FOR — the id in the shipped library manifest.
  themeId String      @map("theme_id")
  /// Denormalised from the theme, so that FR-POS-13's filter is expressible in SQL without
  /// loading the manifest. The manifest is still the source of truth; this is a mirror, and
  /// `docs/fixtures/poster-themes.json` is the one table of cases both sides are held to.
  family  ThemeFamily
  blobKey String      @map("blob_key")

  // --- the rest of the key, stored as columns as well as composed into theme_key ---------
  //
  // Both, deliberately. The composed key is what the unique constraint protects and what a
  // lookup uses; the columns are what a human asks questions of ("which solemn themes have
  // we actually generated"). A key you can only match exactly is a key you cannot audit.
  eventType   EventType @map("event_type")
  milestone   String?
  palette     String
  aspectRatio String    @map("aspect_ratio")

  /// FR-POS-04's "hand-approved". **Defaults to FALSE**, and the picker only ever offers
  /// approved rows.
  ///
  /// TBD-5 — visual identity and poster art direction — was due at M4 and is still open, so
  /// nothing in M6 can set this honestly. The themes M6 ships are visibly placeholder and
  /// say so in their own display names. The column is the switch TBD-5 throws; a session
  /// cannot throw it, because "hand-approved" names a hand. docs/M6_PLAN.md §2.1.
  approved Boolean @default(false)

  /// FR-POS-03's whole argument, as a number: "generated once and served thousands of times".
  /// Incremented on every hit, which is what makes §13's "theme cache-hit rate" health metric
  /// and TBD-3's credit re-check queries rather than estimates.
  hitCount Int @default(0) @map("hit_count")

  /// What produced the artwork, for the same reason `ai_usage` records it: a cached image
  /// nobody can trace to a model and a prompt version cannot be re-made when either changes.
  /// Null for artwork that was not generated at all — the placeholder set.
  provider      String?
  model         String?
  promptVersion String? @map("prompt_version")

  createdAt DateTime @default(now()) @map("created_at")

  /// The picker's query: approved artwork of one family for one event type.
  @@index([family, eventType, approved])
  @@map("theme_cache")
}

/// One poster generation JOB. REQUIREMENTS.md §8's `generation`.
///
/// ## Why this is not `AiUsage`
///
/// §8 draws one table and M5 built `AiUsage`, which has the cost half and none of `status`,
/// `latency_ms`, `cache_hit` or `prompt_hash`. Collapsing the two loses the measurement this
/// milestone exists to produce, so they are separate and `ai_usage.generation_id` joins them.
/// Raised rather than quietly resolved in docs/M6_PLAN.md §3.3.
///
/// They are different cardinalities:
///
///   - `AiUsage` is one row **per model call**. That is its contract, and the global spend
///     cap sums it.
///   - A generation is one user-visible **job** making ZERO model calls on a cache hit, one
///     on a copy-only path, and two on a full miss (copy-and-theme, then image).
///
/// One table cannot mean both without one meaning becoming a lie, and the lie would be the
/// expensive one. docs/BUILD_PROMPT_M6.md's definition-of-done item 5 requires that a cache
/// hit "writes no ledger row for a generation that did not happen". If `AiUsage` were also
/// the generation record, a hit would either write a zero-cost row — making its row count
/// stop meaning "calls made", which is what the spend cap reads — or write nothing, making
/// the cache-hit rate unmeasurable. That rate is the number §13 lists as a health metric,
/// TBD-3 waits on, and FR-MON-03a's margin guard is built from.
model Generation {
  id     String  @id @default(uuid(7))
  /**
   * NULLABLE since M9, `SetNull` below, for the same reason and by the same decision as
   * `ai_usage.user_id`: a `generation` row holds status, cache hit, latency, INR cost and a
   * moderation verdict, and no user content whatsoever. Anonymised rather than erased so the
   * cache-hit rate §13 lists as a health metric, TBD-3 waits on and FR-MON-03a is built from
   * does not develop holes every time somebody deletes an account.
   */
  userId String? @map("user_id")

  /// Same vocabulary as `ai_usage.feature`: "poster" here, "gift_ideas" in M8.
  feature  String
  personId String? @map("person_id")

  status GenerationStatus @default(QUEUED)

  /// **The point of the table.** True when the background came from `theme_cache` or the
  /// shipped library and no model was called.
  cacheHit Boolean @default(false) @map("cache_hit")

  /// True when this request was served from cached themes because a rail bit rather than
  /// because the user chose it — the global spend cap (§10 rule 6), the per-user limit, or a
  /// provider failure.
  ///
  /// Distinct from `cacheHit`, and the distinction is the one somebody will want: both end in
  /// the same picture, and only one of them means the budget ran out. "How often did we
  /// degrade" is a different question from "how often did we hit the cache", and a single
  /// boolean would answer neither.
  degraded Boolean @default(false)

  /// §10 rule 7. UNCHECKED is honest — see `ModerationVerdict`.
  moderation ModerationVerdict @default(UNCHECKED)

  /// Which prompt produced it, and a hash of what was actually asked (§8, §10 rule 4). The
  /// prompt TEXT is never stored: it carries a person's name, their relation and their
  /// traits, and §11 bans PII where it does not belong.
  promptHash    String? @map("prompt_hash")
  promptVersion String? @map("prompt_version")

  /// FR-POS-09's targets: p95 under 15s on a miss, under 2s on a hit. Measured from accepting
  /// the request to the poster existing, so it includes the queue wait — which is the number
  /// the user experiences and therefore the only one worth a target.
  latencyMs Int? @map("latency_ms")

  /// The sum of this job's `ai_usage` rows, denormalised. Zero on a cache hit, and that zero
  /// is a fact rather than a gap: no call was made.
  costInr Decimal @default(0) @map("cost_inr") @db.Decimal(12, 4)

  /// A code a developer can act on, never shown to a user. On BLOCKED, why.
  errorCode String? @map("error_code")

  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @default(now()) @updatedAt @map("updated_at")
  completedAt DateTime? @map("completed_at")

  user    User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  calls   AiUsage[]
  posters Poster[]

  @@index([userId, createdAt])
  /// §13's health metric: the cache-hit rate per feature over a window, in one query.
  @@index([feature, cacheHit, createdAt])
  @@map("generation")
}

/// One composited poster, in one format (FR-POS-01, FR-POS-05).
///
/// Separate from `Asset` even though every poster has one, because a poster carries facts an
/// asset has no business holding — which theme, which family, and **what the sentiment was
/// when it was made**. `Asset` also holds source photos, for which all three are meaningless,
/// so folding them together would mean three nullable columns that are only ever null for one
/// kind. The asset is the bytes; the poster is what they are a picture of.
///
/// **NOT a synced entity, and that is a decision with reasons** — docs/M6_PLAN.md §4. The
/// sync engine's three rules exist to reconcile concurrent EDITS, and a poster is generated
/// server-side, immutable once composited, and never edited by a client: last-write-wins on a
/// binary nobody writes is ceremony. The reference the client needs already syncs, on
/// `wish.poster_id`, which M5 reserved for exactly this. What the client wants offline is the
/// FILE, which a cursor would not give it.
///
/// If a later milestone wants a cross-device poster gallery, the fifth cursor entity is the
/// same mechanical shape M1 used for traits and M5 for wishes — `sync-cursor.ts` decodes a
/// missing key as null and takes a full resync, which is the correct delta for an entity a
/// client has never seen.
model Poster {
  id       String @id @default(uuid(7))
  userId   String @map("user_id")
  personId String @map("person_id")

  /// The job that made it. Nullable only so a poster can outlive a pruned generation row.
  generationId String? @map("generation_id")

  themeId String      @map("theme_id")
  family  ThemeFamily

  /// **The sentiment as the server derived it AT GENERATION TIME**, by `sentimentFor()` and
  /// nothing else (FR-EVT-01a; there is exactly one implementation per side and M6 does not
  /// add a third).
  ///
  /// Stored rather than re-derived on read, for the same reason `wish.sentiment` is: it is a
  /// fact about the moment the picture was made. It is also the audit trail for the one
  /// failure this milestone is most likely to produce — a celebratory theme on a death
  /// anniversary — because `family != CELEBRATORY WHERE sentiment = SOLEMN` is then a query
  /// rather than an inspection of every image.
  sentiment Sentiment
  eventType EventType @map("event_type")

  format  PosterFormat
  assetId String       @map("asset_id")

  /// The SOURCE PHOTO this poster was composited from, or null when it was typographic
  /// (FR-POS-06 / OD-11 — most people in a 600-person contact list have no photo).
  ///
  /// **Added in M9, because FR-SET-06's "unless attached to a saved poster" was otherwise not
  /// expressible at all** (docs/M9_PLAN.md C3). `asset_id` above points at the OUTPUT png;
  /// nothing recorded the input. The pipeline picked the person's most recent non-tombstoned
  /// SOURCE_PHOTO and forgot which one, while every new upload tombstones the previous photo —
  /// so "the person's current photo" is not the one a six-month-old poster was made from, and
  /// the sweep had no way to tell which photos a poster depends on.
  ///
  /// M9's migration BACKFILLS this for every poster M6 made, by the same rule the pipeline
  /// used: the most recent SOURCE_PHOTO for that person created at or before the poster. So
  /// there is no heuristic at sweep time — the sweep asks for a recorded link and nothing else.
  sourceAssetId String? @map("source_asset_id")

  /// FR-POS-08 / OD-9: free-tier posters carry subtle WishKaro attribution; Premium removes
  /// it. **Defaults to true** and M7 is what can make it false — M6 builds the switch and one
  /// function that answers "is this user premium" with `false`. Recorded per poster rather
  /// than derived from the user's tier on read, because a poster made while free stays the
  /// poster that was made, and a subscription lapsing must not retroactively rewrite what
  /// somebody already sent.
  attributed Boolean @default(true)

  createdAt DateTime  @default(now()) @map("created_at")
  deletedAt DateTime? @map("deleted_at")

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  person Person @relation(fields: [personId], references: [id], onDelete: Cascade)
  asset  Asset  @relation("PosterOutput", fields: [assetId], references: [id], onDelete: Cascade)

  /// `SetNull`, not `Cascade`: a retention purge removes the source photo's BYTES and keeps
  /// its row, but if the row ever does go, the poster it produced must survive. A poster is
  /// the thing the user made and may already have sent; the photo is an input to it.
  sourceAsset Asset? @relation("PosterSource", fields: [sourceAssetId], references: [id], onDelete: SetNull)

  generation Generation? @relation(fields: [generationId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([personId, createdAt])
  /// REQUIREMENTS.md §11's tone-safety clause, as something a test can ask the database:
  /// "no SOLEMN event can ever produce ... a celebratory template".
  @@index([sentiment, family])
  @@map("poster")
}

/// A user's report of generated content (FR-POS-12, FR-SET-07, §12's Play GenAI box).
///
/// Play's GenAI policy requires an in-app reporting mechanism for generated output. It is a
/// POLICY gate rather than a feature, which makes it the kind of thing that is painful to
/// discover during submission — §9 has listed `POST /v1/ai/report` since v1 and nothing has
/// ever written to it.
///
/// Covers BOTH surfaces (docs/M6_PLAN.md §5): a poster and a drafted wish. Building it for
/// posters only would leave §10 rule 7 unmet for the feature that is already in users' hands
/// and move the debt silently to M7.
model ContentReport {
  id     String  @id @default(uuid(7))
  /**
   * NULLABLE since M9, `SetNull` below. Dipen's decision, with the ledger.
   * A content report is evidence about the CONTENT, not a record about the reporter. Erasing
   * it on the reporter's own request would delete the record of a complaint — and Play's GenAI
   * obligation is about having a mechanism that produces something durable, not a mailbox.
   * The reporter's identity goes; what they reported stays.
   */
  userId String? @map("user_id")

  /// "poster" | "wish_draft". The same vocabulary as `ai_usage.feature`, so a report can be
  /// lined up against what it cost.
  feature String

  /// What was reported. Exactly one of these is set; both are nullable because the two
  /// surfaces store their output in different tables, and a polymorphic key column would be
  /// a foreign key the database cannot enforce.
  posterId     String? @map("poster_id")
  generationId String? @map("generation_id")

  /// A short category from a fixed client-side list, plus optional free text.
  reason String
  /// The user's own words. Capped at the API. Never logged — §11.
  detail String?

  /// The reported TEXT, copied at report time for a wish draft.
  ///
  /// Copied rather than referenced on purpose: a draft the user never sent has no `wish` row
  /// to point at (FR-WSH-07 writes history only after the hand-off), so without this a report
  /// about an unsent draft would say that something was wrong and not what.
  reportedText String? @map("reported_text")

  createdAt DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([userId, createdAt])
  @@map("content_report")
}
