// WishKaro — M0 schema.
//
// Scope note: M0 ships only the tables the walking skeleton needs. Everything here is
// shaped so the full v1 schema in docs/REQUIREMENTS.md §8 is a pure ADDITION later —
// new tables and new columns — never an alteration of a column that already exists.
//
// Enums therefore carry their FULL v1 value sets today even though M0 only ever writes
// BIRTHDAY / CELEBRATORY / D0. Later milestones add behaviour, not migrations.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums — full v1 value sets (REQUIREMENTS.md §8)
// ---------------------------------------------------------------------------

enum EventType {
  BIRTHDAY
  WEDDING_ANNIVERSARY
  ENGAGEMENT_ANNIVERSARY
  DEATH_ANNIVERSARY
  CUSTOM
}

/// Derived from EventType, never set independently. DEATH_ANNIVERSARY is SOLEMN;
/// everything else is CELEBRATORY (FR-EVT-01a). Gates tone, templates, copy and the
/// entire gift surface in later milestones — it is not cosmetic.
enum Sentiment {
  CELEBRATORY
  SOLEMN
}

/// v1 only ever writes GREGORIAN (OD-12). The column exists so lunar/tithi dates can be
/// added later without a migration (FR-EVT-07).
enum CalendarSystem {
  GREGORIAN
}

/// Reminder ladder steps (FR-REM-03). M0 ships D0 only.
enum ReminderOffset {
  D7
  D1
  D0
}

enum ReminderChannel {
  FCM
  LOCAL
}

enum ReminderStatus {
  PENDING
  SENT
  DELIVERED
  FAILED
  SUPPRESSED
}

enum DevicePlatform {
  ANDROID
  IOS
}

/// Progressive profile enrichment (FR-PPL-04). Full v1 value set now; M1 collects all four.
/// Gift suggestions in M8 are only as good as what accumulates here, which is why the table
/// exists two milestones before the feature that reads it.
enum TraitKind {
  HOBBY
  LIKE
  DISLIKE
  BUDGET_BAND
}

/// Where a trait came from. M1 only ever writes USER; IMPORT is M3 and INFERRED is M5+.
/// Kept distinct because an inferred trait must never be shown as though the user said it.
enum TraitSource {
  USER
  IMPORT
  INFERRED
}

// ---------------------------------------------------------------------------
// Tables
// ---------------------------------------------------------------------------

model User {
  id        String  @id @default(uuid(7))
  googleSub String  @unique @map("google_sub")
  email     String
  name      String?
  photoUrl  String? @map("photo_url")
  locale    String?
  /// IANA zone, e.g. "Asia/Kolkata". Reminders fire in the owner's CURRENT timezone;
  /// changing this reschedules every PENDING reminder (FR-EVT-08).
  timezone  String  @default("Asia/Kolkata")

  createdAt DateTime  @default(now()) @map("created_at")
  deletedAt DateTime? @map("deleted_at")

  people        Person[]
  traits        PersonTrait[]
  events        Event[]
  reminders     Reminder[]
  devices       Device[]
  refreshTokens RefreshToken[]

  @@index([email])
  @@map("user")
}

model Person {
  id              String  @id @default(uuid(7))
  userId          String  @map("user_id")
  displayName     String  @map("display_name")
  relationToOwner String? @map("relation_to_owner")
  /// The person record representing the signed-in user themselves (FR-AUTH-04).
  isSelf          Boolean @default(false) @map("is_self")

  // --- M1: optional profile fields, all progressively collected (FR-PPL-04) ------------
  /// Reserved for the R2 object key. NOTHING writes this in M1 — uploads are M6. The column
  /// exists now so the feature is a code change later rather than a migration.
  photoKey String? @map("photo_key")
  /// Free text, deliberately not an enum: an enum of genders is a product decision this app
  /// has no reason to make, and gift logic in M8 reads traits rather than this field.
  gender   String?
  phone    String?
  email    String?
  notes    String?

  /// Set when a DEATH_ANNIVERSARY is created for this person (FR-EVT-04), and it changes the
  /// sentiment of EVERY event they own — see sentimentFor() in modules/events/derived.ts.
  /// Never trusted from a client on an event write; derived there.
  isDeceased Boolean @default(false) @map("is_deceased")

  /// DERIVED from a known birth year implying age < 18 (FR-PPL-09). Impossible to set from a
  /// client. Flagged records are excluded from profiling and from the completeness nudge.
  isMinor Boolean @default(false) @map("is_minor")

  /// DERIVED 0..100 (FR-PPL-05). Weights live in ONE place: COMPLETENESS_WEIGHTS.
  completenessScore Int @default(0) @map("completeness_score")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @default(now()) @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  user   User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  events Event[]
  traits PersonTrait[]

  /// Drives the sync cursor: (updatedAt, id) is the monotonic ordering.
  @@index([userId, updatedAt, id])
  @@map("person")
}

/// Progressive profile enrichment (FR-PPL-04), as chips in the UI.
///
/// `updatedAt` and `deletedAt` are not in REQUIREMENTS.md §8's sketch, which has only
/// `created_at`. Both are required here: traits sync like everything else, and sync needs a
/// monotonic ordering key and a tombstone. Adding them now is free; retrofitting them would
/// mean a migration and a second code path.
model PersonTrait {
  id       String @id @default(uuid(7))
  personId String @map("person_id")
  /// Denormalised from person, exactly as `event.user_id` is: the sync cursor scans by owner
  /// and ordering, and a join to person for every page would be the one slow query in the
  /// hot path.
  userId   String @map("user_id")

  kind   TraitKind
  value  String
  source TraitSource @default(USER)

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @default(now()) @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  person Person @relation(fields: [personId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Drives the sync cursor for traits, the third entity after person and event.
  @@index([userId, updatedAt, id])
  @@index([personId])
  @@map("person_trait")
}

model Event {
  id       String @id @default(uuid(7)) @map("id")
  personId String @map("person_id")
  userId   String @map("user_id")

  type      EventType
  sentiment Sentiment

  /// Day and month are always known. Year is nullable — "year unknown" birthdays are a
  /// first-class case, not a UI concern (FR-EVT-02).
  day   Int
  month Int
  year  Int?

  calendarSystem CalendarSystem @default(GREGORIAN) @map("calendar_system")

  /// User-supplied name for a CUSTOM event (FR-EVT-06). Null for every other type — a
  /// BIRTHDAY does not need a label and must not be given one.
  label String?

  /// Stops reminders without deleting the event. Distinct from deletedAt on purpose: a muted
  /// event still appears on the person, still counts towards their profile, and can be
  /// un-muted; a deleted one cannot.
  isMuted Boolean @default(false) @map("is_muted")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @default(now()) @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  person      Person            @relation(fields: [personId], references: [id], onDelete: Cascade)
  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  occurrences EventOccurrence[]

  @@index([userId, updatedAt, id])
  @@index([personId])
  @@map("event")
}

/// One materialised occurrence of an event, per calendar year.
///
/// The effective date is always COALESCE(override_date, occurs_on) — wired from the first
/// line of code even though nothing writes override_date in M0 (OD-16 / FR-EVT-10).
model EventOccurrence {
  id      String @id @default(uuid(7))
  eventId String @map("event_id")

  /// The year this row materialises. Unique per event, so re-running the materialiser is
  /// idempotent AND editing the event's date updates this row rather than orphaning it.
  occurrenceYear Int @map("occurrence_year")

  /// Base date computed from the event in the owner's timezone. For a 29 Feb birthday in a
  /// non-leap year this is 28 Feb (FR-EVT-09).
  occursOn     DateTime  @map("occurs_on") @db.Date
  /// Moves a single year's occurrence without touching the base event (FR-EVT-10).
  overrideDate DateTime? @map("override_date") @db.Date

  /// DERIVED (FR-EVT-03). Materialised here rather than recomputed per push, and present in
  /// REQUIREMENTS.md §8 — M0 omitted it because nothing could produce one yet. For a
  /// DEATH_ANNIVERSARY this is a plain year count ("12 years") and NEVER a celebratory
  /// milestone name: no Silver, no Golden.
  milestoneLabel String? @map("milestone_label")

  computedAt DateTime @default(now()) @map("computed_at")

  event     Event      @relation(fields: [eventId], references: [id], onDelete: Cascade)
  reminders Reminder[]

  @@unique([eventId, occurrenceYear])
  /// Drives the scheduler (REQUIREMENTS.md §8 indexing notes).
  @@index([occursOn])
  @@map("event_occurrence")
}

model Reminder {
  id String @id @default(uuid(7))

  /// NULLABLE by design. POST /v1/reminders/test must work before any person, event or
  /// occurrence exists — that is the whole point of building it first. A null FK means a
  /// self-test reminder and the send worker uses generic copy. See docs/M0_PLAN.md §1.2.
  eventOccurrenceId String? @map("event_occurrence_id")
  userId            String  @map("user_id")

  offset         ReminderOffset
  /// Always UTC. User-facing times are derived in the owner's timezone, never stored.
  scheduledAtUtc DateTime        @map("scheduled_at_utc")
  channel        ReminderChannel @default(FCM)
  status         ReminderStatus  @default(PENDING)

  /// Unique across the table. Carried in the FCM payload so the client can drop a repeat
  /// even when the server retries or the local-alarm fallback (M2) fires too.
  dedupeKey String    @unique @map("dedupe_key")
  sentAt    DateTime? @map("sent_at")

  createdAt DateTime @default(now()) @map("created_at")

  eventOccurrence EventOccurrence? @relation(fields: [eventOccurrenceId], references: [id], onDelete: Cascade)
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Drives the send loop (REQUIREMENTS.md §8 indexing notes).
  @@index([scheduledAtUtc, status])
  @@index([userId])
  @@map("reminder")
}

model Device {
  id       String         @id @default(uuid(7))
  userId   String         @map("user_id")
  fcmToken String         @unique @map("fcm_token")
  platform DevicePlatform
  /// Last timezone this device reported. A change here reschedules pending reminders.
  timezone String?

  lastSeenAt DateTime @default(now()) @map("last_seen_at")
  createdAt  DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("device")
}

/// Not in REQUIREMENTS.md §8 — added in M0 because a *rotating* refresh token is
/// server-side state by definition: rotation means knowing which token is current and
/// invalidating its predecessor. Stored hashed, so a database dump yields nothing usable.
/// See docs/M0_PLAN.md §1.2.
model RefreshToken {
  id        String @id @default(uuid(7))
  userId    String @map("user_id")
  /// SHA-256 of the token. The plaintext is only ever in the response body.
  tokenHash String @unique @map("token_hash")

  expiresAt    DateTime  @map("expires_at")
  revokedAt    DateTime? @map("revoked_at")
  /// Set when this token is rotated, so a replayed old token is detectable.
  replacedById String?   @map("replaced_by_id")

  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_token")
}
